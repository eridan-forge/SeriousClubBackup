 <Window x:Class="серьёзный.ЭкранКлуба.ОкноИсторииОбслуживания"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900"
        Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Topmost="True">

    <Border CornerRadius="20"
            BorderBrush="#5C1826"
            BorderThickness="1.4"
            Background="#050505"
            Padding="24"
            Margin="30">

        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,16">

                <Button DockPanel.Dock="Right"
                        Width="34" Height="34"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#E4A6B4"
                        FontSize="15"
                        Cursor="Hand"
                        Content="✕"
                        Click="Закрыть_Click"/>

                <StackPanel>
                    <TextBlock Text="История действий"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Все действия обслуживания и смены тем на этом ПК"
                               FontSize="12"
                               Foreground="#7D8290"
                               Margin="0,4,0,0"/>
                </StackPanel>

            </DockPanel>

            <DataGrid x:Name="Таблица"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="#100A0D"
                      RowBackground="#160E12"
                      AlternatingRowBackground="#1C1216"
                      BorderBrush="#3A222B"
                      BorderThickness="1"
                      Foreground="White">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#241419"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,6"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,4"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Время" Width="150"
                                        Binding="{Binding Time, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}"/>
                    <DataGridTextColumn Header="Источник" Width="160"
                                        Binding="{Binding AdminName}"/>
                    <DataGridTextColumn Header="Действие" Width="220"
                                        Binding="{Binding Action}"/>
                    <DataGridTextColumn Header="Детали" Width="*"
                                        Binding="{Binding Details}"/>
                </DataGrid.Columns>

            </DataGrid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">

                <Button Width="150" Height="40"
                        Margin="0,0,10,0"
                        Background="#241419"
                        Foreground="White"
                        BorderBrush="#5C1826"
                        BorderThickness="1"
                        Cursor="Hand"
                        Content="🔄 Обновить"
                        Click="Обновить_Click"/>

                <Button Width="120" Height="40"
                        Background="#E5142F"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Content="Закрыть"
                        Click="Закрыть_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>