<Window x:Class="серьёзный.ЭкранКлуба.ОкноПодробностейИгры"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Width="920" Height="600"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Стили/СтильИгрока.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="24" Background="{StaticResource ФонКарточки}"
            BorderBrush="{StaticResource РамкаЦвет}" BorderThickness="1.4">

        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="✕" Style="{StaticResource КруглаяКнопкаЗакрытия}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Panel.ZIndex="10" Margin="0,-16,-16,0" Click="Закрыть_Click"
                    Grid.ColumnSpan="3"/>

            <!-- ЛЕВО: обложка + название + рейтинг -->
            <StackPanel Grid.Column="0">

                <Border CornerRadius="18" ClipToBounds="True" Height="380">
                    <Grid>
                        <Image x:Name="Обложка" Stretch="UniformToFill"/>
                        <Grid x:Name="Заглушка" Background="{StaticResource ФонКарточкиАльт}">
                            <TextBlock Text="🎮" FontSize="90" Opacity="0.3"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock x:Name="Название" FontSize="24" FontWeight="Bold" Foreground="White"
                           TextWrapping="Wrap" Margin="0,16,0,0"/>
                <TextBlock x:Name="Категория" Foreground="{StaticResource ТекстВторичный}" Margin="0,4,0,16"/>

                <StackPanel x:Name="ПанельЗвёзд" Orientation="Horizontal"/>
                <TextBlock x:Name="ТекстРейтинг" Foreground="{StaticResource ТекстВторичный}" Margin="0,8,0,0"/>

                <Button Content="▶ ИГРАТЬ" Style="{StaticResource БольшаяКнопкаДействияВажная}"
                        HorizontalAlignment="Stretch" Margin="0,20,0,0" Click="Играть_Click"/>

            </StackPanel>

            <!-- ПРАВО: вкладки -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button x:Name="ВкладкаОписание" Tag="Активна" Content="Описание"
                            Style="{StaticResource ПодвкладкаКнопка}" Click="ПоказатьОписание_Click"/>
                    <Button x:Name="ВкладкаОтзывы" Content="Отзывы" Style="{StaticResource ПодвкладкаКнопка}"
                            Click="ПоказатьОтзывы_Click" Margin="10,0,0,0"/>
                    <Button x:Name="ВкладкаПомощь" Content="Помощь" Style="{StaticResource ПодвкладкаКнопка}"
                            Click="ПоказатьПомощь_Click" Margin="10,0,0,0"/>
                </StackPanel>

                <ScrollViewer x:Name="СтраницаОписание" Grid.Row="1">
                    <TextBlock x:Name="ТекстОписание" Foreground="{StaticResource ТекстОсновной}"
                               FontSize="15" TextWrapping="Wrap" LineHeight="24"/>
                </ScrollViewer>

                <Grid x:Name="СтраницаОтзывы" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource КарточкаМалая}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Оставить отзыв" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBox x:Name="ПолеНовогоОтзыва" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                            <Button Content="Отправить отзыв" Width="160" HorizontalAlignment="Left"
                                    Margin="0,10,0,0" Click="ОтправитьОтзыв_Click"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel x:Name="СписокОтзывов"/>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="СтраницаПомощь" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource КарточкаМалая}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Задать вопрос сообществу" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBox x:Name="ПолеВопроса" AcceptsReturn="True" Height="50" TextWrapping="Wrap"/>
                            <Button Content="Спросить" Width="140" HorizontalAlignment="Left"
                                    Margin="0,10,0,0" Click="ЗадатьВопрос_Click"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel x:Name="СписокПомощи"/>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>