<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:поведения="clr-namespace:серьёзный.ЭкранКлуба.Поведения">

    <SolidColorBrush x:Key="ФонОсновной" Color="#0A0A0C"/>
    <SolidColorBrush x:Key="ФонБоковойПанели" Color="#0F0B0D"/>
    <SolidColorBrush x:Key="ФонКарточки" Color="#161119"/>
    <SolidColorBrush x:Key="ФонКарточкиАльт" Color="#1B1420"/>
    <SolidColorBrush x:Key="РамкаЦвет" Color="#241419"/>
    <SolidColorBrush x:Key="АкцентКрасный" Color="#E5142F"/>
    <SolidColorBrush x:Key="ТекстОсновной" Color="White"/>
    <SolidColorBrush x:Key="ТекстВторичный" Color="#8A8F9A"/>
    <SolidColorBrush x:Key="ТекстПриглушённый" Color="#565A66"/>
    <SolidColorBrush x:Key="Успех" Color="#22C55E"/>
    <SolidColorBrush x:Key="Опасность" Color="#F87171"/>
    <SolidColorBrush x:Key="Предупреждение" Color="#FB923C"/>
    <SolidColorBrush x:Key="Золото" Color="#FBBF24"/>

    <!-- Фон панели категорий: стеклянный градиент вместо плоской заливки -->
    <LinearGradientBrush x:Key="ФонПанелиКатегорий" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#59241419" Offset="0"/>
        <GradientStop Color="#40161119" Offset="0.55"/>
        <GradientStop Color="#26000000" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Карточка" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ФонКарточки}"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="BorderBrush" Value="{StaticResource РамкаЦвет}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="КарточкаМалая" TargetType="Border" BasedOn="{StaticResource Карточка}">
        <Setter Property="Padding" Value="18"/>
        <Setter Property="CornerRadius" Value="14"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ФонКарточкиАльт}"/>
        <Setter Property="Foreground" Value="{StaticResource ТекстОсновной}"/>
        <Setter Property="CaretBrush" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource РамкаЦвет}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Height" Value="36"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ФонКарточкиАльт}"/>
        <Setter Property="Foreground" Value="{StaticResource ТекстОсновной}"/>
        <Setter Property="BorderBrush" Value="{StaticResource РамкаЦвет}"/>
        <Setter Property="Height" Value="36"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ФонКарточкиАльт}"/>
        <Setter Property="Foreground" Value="{StaticResource ТекстОсновной}"/>
        <Setter Property="BorderBrush" Value="{StaticResource РамкаЦвет}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Фон" CornerRadius="12"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Фон" Property="BorderBrush" Value="{StaticResource АкцентКрасный}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Фон" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Фон" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="НавКнопка" TargetType="Button">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ТекстВторичный}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Фон" CornerRadius="12" Background="Transparent"/>
                        <Border x:Name="Полоска" Width="3" HorizontalAlignment="Left"
                                CornerRadius="2" Background="{StaticResource АкцентКрасный}"
                                Opacity="0" Margin="0,6"/>
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Фон" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Активна">
                            <Setter TargetName="Фон" Property="Background" Value="{StaticResource ФонКарточкиАльт}"/>
                            <Setter TargetName="Полоска" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ДействиеКнопка" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Background" Value="{StaticResource АкцентКрасный}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="ДействиеКнопкаОпасная" TargetType="Button" BasedOn="{StaticResource ДействиеКнопка}">
        <Setter Property="Background" Value="{StaticResource ФонКарточкиАльт}"/>
        <Setter Property="Foreground" Value="{StaticResource Опасность}"/>
        <Setter Property="BorderBrush" Value="#5C1826"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="ДействиеКнопкаВторичная" TargetType="Button" BasedOn="{StaticResource ДействиеКнопка}">
        <Setter Property="Background" Value="{StaticResource ФонКарточкиАльт}"/>
        <Setter Property="Foreground" Value="{StaticResource ТекстВторичный}"/>
        <Setter Property="BorderBrush" Value="{StaticResource РамкаЦвет}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="БольшаяКнопкаДействия" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="64"/>
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="Margin" Value="0,0,12,12"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="БольшаяКнопкаДействияОпасная" TargetType="Button" BasedOn="{StaticResource БольшаяКнопкаДействия}">
        <Setter Property="Foreground" Value="{StaticResource Опасность}"/>
        <Setter Property="BorderBrush" Value="#5C1826"/>
    </Style>

    <Style x:Key="БольшаяКнопкаДействияВажная" TargetType="Button" BasedOn="{StaticResource БольшаяКнопкаДействия}">
       
        <Setter Property="Foreground" Value="{StaticResource Успех}"/>
        
        <Setter Property="BorderBrush" Value="#14532D"/>
        
    </Style>
    

    <Style x:Key="БольшаяКнопкаДействияПредупреждение" TargetType="Button" BasedOn="{StaticResource БольшаяКнопкаДействия}">
        
        <Setter Property="Foreground" Value="{StaticResource Предупреждение}"/>
        
        <Setter Property="BorderBrush" Value="#7C2D12"/>
        
    </Style>

    <Style x:Key="ВторичнаяКнопкаТоп" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="16,0"/>
    </Style>

    <Style x:Key="ПодвкладкаКнопка" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ТекстВторичный}"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Активна">
                <Setter Property="Background" Value="{StaticResource АкцентКрасный}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource АкцентКрасный}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="КатегорияКнопкаСтекло" TargetType="Button">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Фон" CornerRadius="12"
                                Background="#22FFFFFF"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"/>
                        <Border x:Name="Полоска" Width="3" HorizontalAlignment="Left"
                                CornerRadius="2" Background="{StaticResource АкцентКрасный}"
                                Opacity="0" Margin="0,8"/>
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Фон" Property="Background" Value="#30FFFFFF"/>
                            <Setter TargetName="Фон" Property="BorderBrush" Value="#40FFFFFF"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Активна">
                            <Setter TargetName="Фон" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#66E5142F" Offset="0"/>
                                        <GradientStop Color="#33E5142F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Фон" Property="BorderBrush" Value="#80E5142F"/>
                            <Setter TargetName="Полоска" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="КруглаяКнопкаЗакрытия" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ТекстВторичный}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Круг" CornerRadius="20" Width="40" Height="40" Background="{StaticResource ФонКарточкиАльт}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Круг" Property="Background" Value="#5C1826"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ТонкийСкроллбар" TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#5C1826" CornerRadius="3" Margin="1,0"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0"/>
                        <ScrollBar Grid.Column="1" Style="{StaticResource ТонкийСкроллбар}"
                                   Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   поведения:ФункциональныйСкроллбар.Enabled="True"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>