<UserControl x:Class="серьёзный.ЭкранКлуба.Элементы.КарточкаИгры"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="190"
             Height="300">

    <Border x:Name="Корень"
            Background="#1F2937"
            CornerRadius="18"
            BorderBrush="#334155"
            BorderThickness="1"
            Cursor="Hand">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="195"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image x:Name="Обложка"
                   Stretch="UniformToFill"/>

            <Border Grid.Row="1"
                    Background="#172133">

                <StackPanel Margin="10">

                    <TextBlock x:Name="Название"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="15"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="Категория"
                               Margin="0,4,0,8"
                               Foreground="#94A3B8"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="Играть"
                                Height="34"
                                Content="▶ Играть"
                                Click="Играть_Click"/>

                        <Button Grid.Column="1"
                                x:Name="Избранное"
                                Content="☆"
                                Click="Избранное_Click"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</UserControl>