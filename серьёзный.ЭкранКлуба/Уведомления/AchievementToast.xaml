<Window x:Class="серьёзный.ЭкранКлуба.Уведомления.AchievementToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360"
        Height="130"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Background="#1E293B"
            CornerRadius="18"
            BorderBrush="#FBBF24"
            BorderThickness="2"
            Padding="18">

        <StackPanel>

            <TextBlock Text="🏆 Новое достижение!"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#FBBF24"/>

            <TextBlock x:Name="Название"
                       Margin="0,8,0,0"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="Описание"
                       Margin="0,6,0,0"
                       Foreground="#CBD5E1"
                       TextWrapping="Wrap"/>

        </StackPanel>

    </Border>

</Window>