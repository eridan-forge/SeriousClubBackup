<Window x:Class="серьёзный.ЭкранКлуба.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Topmost="True">

    <Window.Resources>

        <Style x:Key="КнопкаПанели" TargetType="Button">
           
            <!-- заменить строку выше на: -->
            
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Фон" CornerRadius="12" Background="#E5142F">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Фон" Property="Background" Value="#FF2A47"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Фон" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="КнопкаПанелиОпасная" TargetType="Button" BasedOn="{StaticResource КнопкаПанели}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Фон" CornerRadius="12" Background="#5C1826">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Фон" Property="Background" Value="#7A2233"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Фон" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- КРЕСТИК В СТИЛЕ ОКНА -->
        <Style x:Key="КнопкаЗакрытия" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Круг"
                                     Fill="#1E1418"
                                     Stroke="#5C1826"
                                     StrokeThickness="1.4"/>
                            <Path Stroke="#E4A6B4"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="12" Height="12"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Data="M 0,0 L 12,12 M 12,0 L 0,12"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Круг" Property="Stroke" Value="#FF3D66"/>
                                <Setter TargetName="Круг" Property="Fill" Value="#2A1A1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border CornerRadius="20"
            BorderBrush="#5C1826"
            BorderThickness="1.4"
            Background="#050505"
            Padding="26"
            Margin="30">

        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="ВходПанель">

                <TextBlock Text="Режим обслуживания"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Margin="0,14,0,6" Text="Пароль" Foreground="#94A3B8"/>

                <Border Background="#242429"
                        BorderBrush="#34343C"
                        BorderThickness="1"
                        CornerRadius="12"
                        Height="42"
                        Padding="12,0">

                    <PasswordBox x:Name="ПолеПароля"
                                 Background="Transparent"
                                 Foreground="White"
                                 CaretBrush="White"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="ПолеПароля_KeyDown"/>

                </Border>

                <Button Margin="0,20,0,0"
                        Style="{StaticResource КнопкаПанели}"
                        Content="Войти"
                        Click="Войти_Click"/>

                <TextBlock x:Name="ТекстОшибки"
                           Margin="0,12,0,0"
                           Foreground="#FF5C5C"
                           TextAlignment="Center"/>

            </StackPanel>

            <StackPanel x:Name="ПанельАдмина"
                        Grid.RowSpan="4"
                        Visibility="Collapsed">

                <TextBlock Text="Панель обслуживания"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,20"/>

                <Button Style="{StaticResource КнопкаПанели}" Margin="0,0,0,12"
                        Content="▶ Запустить рабочий стол" Click="Запустить_Click"/>

                <Button Style="{StaticResource КнопкаПанели}" Margin="0,0,0,12"
                        Content="🔒 Вернуть блокировку" Click="Заблокировать_Click"/>

                <Button Style="{StaticResource КнопкаПанели}" Margin="0,0,0,12"
                        Content="🔑 Сменить пароль" Click="СменитьПароль_Click"/>

                <Button Style="{StaticResource КнопкаПанели}" Margin="0,0,0,12"
                        Content="📝 Изменить текст экрана" Click="ИзменитьТекст_Click"/>

                <Button Style="{StaticResource КнопкаПанели}" Margin="0,0,0,12"
                        Content="🖼 Сменить обои" Click="СменитьОбои_Click"/>

                <Button Style="{StaticResource КнопкаПанели}" Margin="0,0,0,12"
                        Content="🎲 Случайная тема" Click="СлучайнаяТема_Click"/>

                <Button Style="{StaticResource КнопкаПанели}" Margin="0,0,0,12"
                        Content="🕓 История действий" Click="История_Click"/>

                <Button Style="{StaticResource КнопкаПанелиОпасная}" Margin="0,0,0,12"
                        Content="⏻ Выключить ПК" Click="Выключить_Click"/>

                <Button Style="{StaticResource КнопкаПанелиОпасная}"
                        Content="✕ Закрыть приложение" Click="ЗакрытьПриложение_Click"/>

            </StackPanel>

            <!-- КРЕСТИК поверх обеих панелей -->
            <Button Grid.RowSpan="4"
                    Panel.ZIndex="20"
                    Style="{StaticResource КнопкаЗакрытия}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-6,-6,0"
                    ToolTip="Закрыть"
                    Click="Закрыть_Click"/>

        </Grid>

    </Border>
</Window>