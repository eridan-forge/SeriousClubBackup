 ﻿<Window x:Class="серьёзный.ЭкранКлуба.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380"
        Height="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#111827"
        Topmost="True">

    <Border
        CornerRadius="18"
        BorderBrush="#334155"
        BorderThickness="1"
        Background="#1E293B"
        Padding="24">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="ВходПанель">

                <TextBlock
                    Text="Режим обслуживания"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"/>

                <TextBlock
                    Margin="0,12,0,6"
                    Text="Пароль"
                    Foreground="#94A3B8"/>

                <PasswordBox
                    x:Name="ПолеПароля"
                    Height="38"/>

                <Button
                    Margin="0,20,0,0"
                    Height="40"
                    Content="Войти"
                    Click="Войти_Click"/>

                <TextBlock
                    x:Name="ТекстОшибки"
                    Margin="0,12,0,0"
                    Foreground="#EF4444"
                    TextAlignment="Center"/>

            </StackPanel>

            <StackPanel
                x:Name="ПанельАдмина"
                Grid.RowSpan="4"
                Visibility="Collapsed">

                <TextBlock
                    Text="Панель обслуживания"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Margin="0,0,0,20"/>

                <Button
                    Height="42"
                    Margin="0,0,0,12"
                    Content="▶ Запустить рабочий стол"
                    Click="Запустить_Click"/>

                <Button
                    Height="42"
                    Margin="0,0,0,12"
                    Content="🔒 Вернуть блокировку"
                    Click="Заблокировать_Click"/>

                <Button
                    Height="42"
                    Margin="0,0,0,12"
                    Content="🔑 Сменить пароль"
                    Click="СменитьПароль_Click"/>

                <Button
                    Height="42"
                    Margin="0,0,0,12"
                    Content="📝 Изменить текст экрана"
                    Click="ИзменитьТекст_Click"/>

                <Button
                    Height="42"
                    Content="⏻ Выключить ПК"
                    Click="Выключить_Click"/>

            </StackPanel>

        </Grid>

    </Border>
</Window>