<Window x:Class="серьёзный.ЭкранКлуба.ОкноИгрока"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:карусель="clr-namespace:серьёзный.ЭкранКлуба.Карусель"
        WindowStyle="None"
        WindowState="Maximized"
        Background="{DynamicResource ФонОсновной}"
        ShowInTaskbar="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Стили/СтильИгрока.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <!-- ===================== БОКОВАЯ ПАНЕЛЬ ===================== -->
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource ФонБоковойПанели}"
                BorderBrush="{StaticResource РамкаЦвет}" BorderThickness="0,0,1,0">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,22" MouseLeftButtonDown="ПеретаскиваниеОкна">

                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="9"
                                Background="{StaticResource АкцентКрасный}" Margin="0,0,10,0">
                            <TextBlock Text="С" FontSize="18" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="СЕРЬЁЗНЫЙ" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource АкцентКрасный}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="ИмяИгрока" Text="Игрок" FontSize="15" FontWeight="SemiBold"
                               Foreground="White" Margin="0,14,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ТекстПК" Text="ПК-00" FontSize="12" Foreground="{StaticResource ТекстВторичный}" Margin="0,2,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,6,10,0">
                        <Button x:Name="КнопкаГлавная" Style="{StaticResource НавКнопка}" Content="🏠  Главная"/>
                        <Button x:Name="КнопкаИгры" Style="{StaticResource НавКнопка}" Content="🎮  Игры"/>
                        <Button x:Name="КнопкаМагазин" Style="{StaticResource НавКнопка}" Content="🛒  Магазин"/>
                        <Button x:Name="КнопкаРазвлечения" Style="{StaticResource НавКнопка}" Content="🎰  Развлечения"/>
                        <Button x:Name="КнопкаПрофиль" Style="{StaticResource НавКнопка}" Content="👤  Профиль"/>
                        <Button x:Name="КнопкаИгроки" Style="{StaticResource НавКнопка}" Content="👥  Игроки клуба"/>
                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ===================== ПРАВАЯ ЧАСТЬ ===================== -->
        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
            <Border Grid.Row="0" Background="{StaticResource ФонБоковойПанели}"
                    BorderBrush="{StaticResource РамкаЦвет}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="ПеретаскиваниеОкна">
                <Grid Margin="24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏱" FontSize="17" Foreground="{StaticResource АкцентКрасный}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ТекстОсталосьКратко" Text="00:00:00" FontSize="19" FontWeight="Bold"
                                   Foreground="White" Margin="8,0,20,0" VerticalAlignment="Center"/>

                        <Border x:Name="БлокБаллов" Background="{StaticResource ФонКарточкиАльт}" CornerRadius="10" Padding="10,5" Margin="0,0,10,0">
                            <TextBlock x:Name="ТекстБаллыКратко" Text="⭐ 0" Foreground="{StaticResource Золото}" FontWeight="Bold"/>
                        </Border>

                        <Border x:Name="БлокПремиум" Background="#241419" CornerRadius="10" Padding="10,5" Visibility="Collapsed">
                            <TextBlock Text="⭐ ПРЕМИУМ" Foreground="#FFD700" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="КнопкаЧатПереключить" Content="💬  Чат с администратором"
                                Style="{StaticResource ВторичнаяКнопкаТоп}" Click="ПереключитьЧат_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- СТРАНИЦЫ + ЧАТ -->
            <Grid Grid.Row="1">

                <!-- ГЛАВНАЯ -->
                <ScrollViewer x:Name="СтраницаГлавная" Padding="28">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Карточка}">
                            <StackPanel>
                                <TextBlock Text="ОСТАЛОСЬ ВРЕМЕНИ" Foreground="{StaticResource ТекстВторичный}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="БольшойТаймер" Text="00:00:00" FontSize="60" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"/>
                                <TextBlock x:Name="ТекстСтатус" Text="Играет" Foreground="{StaticResource Успех}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <Border Style="{StaticResource КарточкаМалая}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Сыграно всего" Foreground="{StaticResource ТекстВторичный}" FontSize="12"/>
                                    <TextBlock x:Name="ТекстСыграно" Text="00:00" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource КарточкаМалая}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Сеансов" Foreground="{StaticResource ТекстВторичный}" FontSize="12"/>
                                    <TextBlock x:Name="ТекстСеансов" Text="0" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="Тарифы" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,26,0,12"/>
                        <WrapPanel x:Name="ПанельТарифыГлавная"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ИГРЫ -->
                
                <Grid x:Name="СтраницаИгры" Visibility="Collapsed" Margin="28,28,28,0">
                    
                    <Grid.RowDefinitions>
                        
                        <RowDefinition Height="Auto"/>
                        
                        <RowDefinition Height="*"/>
                        
                    </Grid.RowDefinitions>
                    

                    <DockPanel Margin="0,0,0,10">
                        
                        <TextBox x:Name="ПоискИгр" Width="280" Margin="0,0,10,0" TextChanged="ПоискИгр_TextChanged"/>
                        
                        <ComboBox x:Name="Категории" Width="180" SelectionChanged="Категории_SelectionChanged"/>
                        
                    </DockPanel>
                    

                    <Grid Grid.Row="1">
                        

                        <карусель:КарусельИгр x:Name="КарусельИгрЭлемент"/>
                        

                        <!-- Всплывающая плашка "Игра скрыта • Отменить" -->
                        
                        <Border x:Name="ПлашкаОтменыСкрытия"
                                Background="#EE1E1420"
                                BorderBrush="#5C1826"
                                BorderThickness="1.3"
                                CornerRadius="16"
                                Padding="20,14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,26"
                                Visibility="Collapsed">
                            

                            <Border.Effect>
                                
                                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
                                
                            </Border.Effect>
                            

                            <StackPanel Orientation="Horizontal">
                                
                                <TextBlock x:Name="ТекстПлашкиОтмены"
                                           Text="Игра скрыта"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Margin="0,0,18,0"/>
                                <Button Content="Отменить" Click="ОтменитьСкрытие_Click"/>
                           </StackPanel>
                            

                        </Border>
                        

                    </Grid>
                    

                </Grid>

                <!-- МАГАЗИН -->
                <Grid x:Name="СтраницаМагазин" Visibility="Collapsed" Margin="28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Button x:Name="ВкладкаКаталог" Tag="Активна" Content="Каталог" Style="{StaticResource ПодвкладкаКнопка}" Click="ПоказатьКаталогМагазина_Click"/>
                        <Button x:Name="ВкладкаЗаказы" Content="Мои заказы" Style="{StaticResource ПодвкладкаКнопка}" Click="ПоказатьЗаказыМагазина_Click" Margin="10,0,0,0"/>
                    </StackPanel>

                    <ScrollViewer x:Name="СкроллКаталог" Grid.Row="1">
                        <WrapPanel x:Name="ПанельМагазина"/>
                    </ScrollViewer>

                    <ScrollViewer x:Name="СкроллЗаказы" Grid.Row="1" Visibility="Collapsed">
                        <StackPanel x:Name="ПанельЗаказов"/>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{StaticResource ФонБоковойПанели}" CornerRadius="12" Margin="0,10,0,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ЛентаРекламы" Orientation="Horizontal" Margin="16,14"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- РАЗВЛЕЧЕНИЯ -->
                <ScrollViewer x:Name="СтраницаРазвлечения" Visibility="Collapsed" Padding="28">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Карточка}">
                            <StackPanel>
                                <TextBlock Text="🎰 Казино" FontSize="19" FontWeight="Bold" Foreground="White"/>
                                <TextBlock x:Name="ТекстПравилаКазино" Foreground="{StaticResource ТекстВторичный}" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBox x:Name="ПолеСтавки" Width="120" Text="10"/>
                                    <Button Content="Крутить" Width="130" Height="36" Margin="10,0,0,0" Click="Крутить_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Карточка}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="📦 Кейсы" FontSize="19" FontWeight="Bold" Foreground="White"/>
                                <WrapPanel x:Name="ПанельКейсов" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ПРОФИЛЬ -->
                <ScrollViewer x:Name="СтраницаПрофиль" Visibility="Collapsed" Padding="28">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Карточка}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="РамкаАватара" Width="104" Height="104" CornerRadius="52" BorderThickness="4" BorderBrush="#4B5563">
                                    <Grid>
                                        <Ellipse Fill="{StaticResource ФонКарточкиАльт}"/>
                                        <TextBlock x:Name="БукваАватара" Text="?" FontSize="42" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ИмяПрофиль" Text="Игрок" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="УровеньПрофиль" Text="Новичок" Foreground="#93C5FD" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="БаллыПрофиль" Text="⭐ 0 баллов" Foreground="{StaticResource Золото}" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="ПремиумПрофиль" Text="" Foreground="#FFD700" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Достижения" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,26,0,12"/>
                        <StackPanel x:Name="ПанельДостиженияПрофиль"/>

                        <TextBlock Text="Рамки профиля" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,26,0,12"/>
                        <WrapPanel x:Name="ПанельРамкиПрофиль"/>

                        <TextBlock Text="Инвентарь" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,26,0,12"/>
                        <WrapPanel x:Name="ПанельИнвентарьПрофиль"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ИГРОКИ -->
                <Grid x:Name="СтраницаИгроки" Visibility="Collapsed" Margin="28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ПоискИгроков" Width="320" HorizontalAlignment="Left" Margin="0,0,0,18" TextChanged="ПоискИгроков_TextChanged"/>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel x:Name="СписокИгроковКлуба"/>
                    </ScrollViewer>
                </Grid>

                <!-- ЧАТ (выезжает справа) -->
                <Border x:Name="ПанельЧат" Width="380" HorizontalAlignment="Right"
                        Background="{StaticResource ФонБоковойПанели}"
                        BorderBrush="{StaticResource РамкаЦвет}" BorderThickness="1,0,0,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="СдвигЧата" X="380"/>
                    </Border.RenderTransform>

                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Чат с администратором" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                        <ScrollViewer x:Name="СкроллЧата" Grid.Row="1">
                            <StackPanel x:Name="ИсторияЧата"/>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="{StaticResource ФонКарточкиАльт}" CornerRadius="12" Padding="8" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="54"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ПолеСообщенияЧат" Background="Transparent" BorderThickness="0" Padding="10"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="Auto" MaxHeight="80"
                                         VerticalScrollBarVisibility="Auto" KeyDown="ПолеСообщенияЧат_KeyDown"/>
                                <Button Grid.Column="1" Content="➤" Margin="8,0,0,0" Click="ОтправитьСообщениеЧат_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ===================== НИЖНЯЯ ПАНЕЛЬ ДЕЙСТВИЙ ===================== -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{StaticResource ФонБоковойПанели}"
                BorderBrush="{StaticResource РамкаЦвет}" BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Button Width="190" Height="74" Margin="10,0,10,0"
                        Style="{StaticResource БольшаяКнопкаДействия}"
                        Click="ВернутьсяКРабочемуСтолу_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🖥" FontSize="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Вернуться к рабочему столу" FontSize="12" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Width="190" Height="74" Margin="10,0,10,0"
                        Style="{StaticResource БольшаяКнопкаДействия}"
                        Click="ВыбратьИгру_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎮" FontSize="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Выбрать игру" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Width="190" Height="74" Margin="10,0,10,0"
                        Style="{StaticResource БольшаяКнопкаДействияПредупреждение}"
                        Click="СообщитьОбОшибке_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🆘" FontSize="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Сообщить об ошибке" FontSize="12" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Width="190" Height="74" Margin="10,0,10,0"
                        Style="{StaticResource БольшаяКнопкаДействияВажная}"
                        Click="Продлить_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⏱" FontSize="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Продлить сеанс" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Width="190" Height="74" Margin="40,0,10,0"
                        Style="{StaticResource БольшаяКнопкаДействия}"
                        Click="ЗавершитьСеанс_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🚪" FontSize="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Выйти из аккаунта" FontSize="12" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>

        </Border>

    </Grid>
</Window>