<Window x:Class="серьёзный.ЭкранКлуба.ОкноРазвлеченияИгрока"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Развлечения"
        Width="900"
        Height="650"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">

    <ScrollViewer Margin="20">
        <StackPanel>

            <TextBlock x:Name="ТекстБаланса"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#FBBF24"
                       Margin="0,0,0,20"/>

            <Border Background="#1E293B" CornerRadius="14" Padding="18" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="🎰 Казино" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox x:Name="ПолеСтавки" Width="120" Height="36" Text="10"/>
                        <Button Content="Крутить" Width="120" Height="36" Margin="10,0,0,0"
                                Click="Крутить_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#1E293B" CornerRadius="14" Padding="18" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="📦 Кейсы" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <WrapPanel x:Name="ПанельКейсов" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#1E293B" CornerRadius="14" Padding="18">
                <StackPanel>
                    <TextBlock Text="🏆 Инвентарь" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <WrapPanel x:Name="ПанельИнвентаря" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</Window>