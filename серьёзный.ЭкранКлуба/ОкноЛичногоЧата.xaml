 ﻿<Window x:Class="серьёзный.ЭкранКлуба.ОкноЛичногоЧата"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат с администратором"
        Width="430"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Администратор"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <ScrollViewer x:Name="Скролл"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="История"/>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#1E293B"
                CornerRadius="12"
                Padding="10"
                Margin="0,12,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ПолеСообщения"
                         Background="#334155"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="10"
                         FontSize="14"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="ПолеСообщения_PreviewKeyDown"/>

                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="➤"
                        FontSize="18"
                        Click="Отправить_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>