<UserControl x:Class="серьёзный.ЭкранКлуба.Развлечения.ЛентаКейса"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="150" ClipToBounds="True">

    <Grid>

        <Border Background="#161119" CornerRadius="14" BorderBrush="#241419" BorderThickness="1"/>

        <StackPanel x:Name="Лента" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="Сдвиг"/>
            </StackPanel.RenderTransform>
        </StackPanel>

        <Rectangle Width="3" Fill="#E5142F" HorizontalAlignment="Center" IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect Color="#E5142F" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
            </Rectangle.Effect>
        </Rectangle>

        <Path Data="M 0,0 L 10,0 L 5,10 Z" Fill="#E5142F" HorizontalAlignment="Center"
              VerticalAlignment="Top" Margin="0,-2,0,0" IsHitTestVisible="False"/>

        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#CC0F0B0D" Offset="0"/>
                    <GradientStop Color="#000F0B0D" Offset="0.35"/>
                    <GradientStop Color="#000F0B0D" Offset="0.65"/>
                    <GradientStop Color="#CC0F0B0D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

    </Grid>

</UserControl>