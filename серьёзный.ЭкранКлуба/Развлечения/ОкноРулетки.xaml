<Window x:Class="серьёзный.ЭкранКлуба.Развлечения.ОкноРулетки"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рулетка"
        Width="720" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="#0A0A0C">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/серьёзный.ЭкранКлуба;component/Стили/СтильИгрока.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🎡 Рулетка" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,18"/>

        <Grid Grid.Row="1" Width="460" Height="460" HorizontalAlignment="Center">
            <Canvas x:Name="ХолстКолеса" Width="460" Height="460"/>

            <Grid x:Name="ОрбитаШарика" Width="460" Height="460" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="ВращениеШарика" Angle="0"/>
                </Grid.RenderTransform>
                <Ellipse Width="18" Height="18" Fill="White" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>

            <Border Width="140" Height="140" CornerRadius="70" Background="#161119" BorderBrush="#5C1826" BorderThickness="2"/>

            <TextBlock x:Name="ТекстРезультат" Text="" FontSize="18" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="КнопкаКрасное" Content="🔴 Красное  x2" Width="150" Height="46" Margin="6,0" Click="ВыбратьЦвет_Click"/>
            <Button x:Name="КнопкаЗелёное" Content="🟢 Зелёное  x14" Width="150" Height="46" Margin="6,0" Click="ВыбратьЦвет_Click"/>
            <Button x:Name="КнопкаЧёрное" Content="⚫ Чёрное  x2" Width="150" Height="46" Margin="6,0" Click="ВыбратьЦвет_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <TextBlock Text="Баллы:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="ТекстБаланс" Text="500" Foreground="{StaticResource Золото}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBox x:Name="ПолеСтавки" Width="100" Text="10"/>
            <Button x:Name="КнопкаКрутить" Content="🎡 КРУТИТЬ" Width="180" Height="42" Margin="14,0,0,0"
                    Style="{StaticResource БольшаяКнопкаДействияВажная}" Click="Крутить_Click"/>
        </StackPanel>
    </Grid>
</Window>