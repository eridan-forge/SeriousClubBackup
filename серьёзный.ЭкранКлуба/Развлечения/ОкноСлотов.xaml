<Window x:Class="серьёзный.ЭкранКлуба.Развлечения.ОкноСлотов"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Слоты"
        Width="620" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0A0A0C">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/серьёзный.ЭкранКлуба;component/Стили/СтильИгрока.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🎰 Слоты" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,18"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel x:Name="ПанельБарабанов" Orientation="Horizontal"/>

            <Grid Width="60" Margin="24,0,0,0" VerticalAlignment="Top">
                <Rectangle Width="10" Height="140" Fill="#5C1826" HorizontalAlignment="Center" VerticalAlignment="Top" RadiusX="5" RadiusY="5"/>
                <Ellipse x:Name="ШарикРычага" Width="34" Height="34" Fill="#E5142F" HorizontalAlignment="Center" VerticalAlignment="Top"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="СдвигРычага" Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="ТекстРезультатСлотов" Text="" FontSize="20" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" Margin="0,16,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <TextBlock Text="Баллы:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="ТекстБаланс" Text="500" Foreground="{StaticResource Золото}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBox x:Name="ПолеСтавки" Width="100" Text="10"/>
            <Button x:Name="КнопкаДёрнуть" Content="🕹 ДЁРНУТЬ РЫЧАГ" Width="220" Height="42" Margin="14,0,0,0"
                    Style="{StaticResource БольшаяКнопкаДействияВажная}" Click="Дёрнуть_Click"/>
        </StackPanel>
    </Grid>
</Window>