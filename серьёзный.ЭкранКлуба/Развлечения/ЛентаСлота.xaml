<UserControl x:Class="серьёзный.ЭкранКлуба.Развлечения.ЛентаСлота"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="120" Height="330" ClipToBounds="True">

    <Grid>
        <Border Background="#161119" CornerRadius="14" BorderBrush="#241419" BorderThickness="1"/>

        <StackPanel x:Name="Лента" VerticalAlignment="Top" HorizontalAlignment="Center">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="Сдвиг"/>
            </StackPanel.RenderTransform>
        </StackPanel>

        <Border BorderBrush="#E5142F" BorderThickness="0,3,0,3" Height="110" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#E5142F" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
            </Border.Effect>
        </Border>
    </Grid>

</UserControl>