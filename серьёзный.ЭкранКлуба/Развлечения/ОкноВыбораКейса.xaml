<Window x:Class="серьёзный.ЭкранКлуба.Развлечения.ОкноВыбораКейса"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кейсы"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#0A0A0C">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/серьёзный.ЭкранКлуба;component/Стили/СтильИгрока.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Выберите кейс" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,18"/>
        <WrapPanel x:Name="Панель"/>
    </DockPanel>

</Window>