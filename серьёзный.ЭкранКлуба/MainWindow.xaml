<Window x:Class="серьёзный.ЭкранКлуба.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="Black"
        ShowInTaskbar="False">

    <Window.Resources>

        <SolidColorBrush x:Key="ОгненнаяРамкаКисть" x:Name="ОгненнаяРамкаКисть" Color="#5C1826"/>

        <!-- Кнопка-ссылка: реагирует только сам текст (лёгкое затемнение
             при наведении), никакой белой плашки под всей шириной кнопки. -->
        <Style x:Key="ТекстоваяКнопка" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid x:Name="Корень">

        <!-- СЛОЙ 1 — ФОНОВОЕ ВИДЕО (дракон, 10 минут, цикл). -->
        <MediaElement x:Name="ФонВидео"
                      Stretch="UniformToFill"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      IsMuted="True"
                      Volume="0"
                      IsHitTestVisible="False"
                      MediaEnded="ФонВидео_MediaEnded"
                      MediaFailed="ФонВидео_MediaFailed">

            <MediaElement.Effect>
                <BlurEffect Radius="3.5"/>
            </MediaElement.Effect>

        </MediaElement>

        <!-- СЛОЙ 2 — ЦЕНТРАЛЬНАЯ ПАНЕЛЬ ВХОДА. -->
        <Border x:Name="ПанельВхода"
                Width="700"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Margin="0"
                Background="#4D050505">

            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="36" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>

            <Grid>

                <!-- лёгкий стеклянный блик у верхнего края панели -->
                <Border VerticalAlignment="Top"
                        Height="260"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#20FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="60,0">

                    <!-- ЛОГОТИП "СЕРЬЁЗНЫЙ" ИЗ PNG -->
                    <Rectangle x:Name="ЛогоФигура"
                               Height="104"
                               Margin="0,40,0,32"
                               Visibility="Collapsed">
                        <Rectangle.Effect>
                            <BlurEffect Radius="1.3"/>
                        </Rectangle.Effect>
                        <Rectangle.Fill>
                            <SolidColorBrush x:Name="ЛогоЦвет" Color="#E5142F"/>
                        </Rectangle.Fill>
                        <Rectangle.OpacityMask>
                            <ImageBrush x:Name="ЛогоМаска" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>

                    <!-- ПОЛЕ ТЕЛЕФОНА -->
                    <Border Background="#242429"
                            BorderBrush="#34343C"
                            BorderThickness="1"
                            CornerRadius="14"
                            Height="52"
                            Width="440"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,14">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="📱"
                                       FontSize="18"
                                       Foreground="#9AA0AE"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <Grid Grid.Column="1" Margin="0,6,14,6">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Номер телефона"
                                           FontSize="10"
                                           Foreground="#7D8290"
                                           Margin="0,0,0,2"/>

                                <Grid Grid.Row="1" VerticalAlignment="Center">

                                    <TextBlock x:Name="ПодсказкаТелефон"
                                               Text="+7"
                                               FontSize="15"
                                               Foreground="#585C66"
                                               IsHitTestVisible="False"/>

                                    <TextBox x:Name="ПолеТелефон"
                                             Background="Transparent"
                                             Foreground="White"
                                             CaretBrush="White"
                                             BorderThickness="0"
                                             FontSize="15"
                                             Padding="0"
                                             VerticalContentAlignment="Center"
                                             TextChanged="ПолеТелефон_TextChanged"/>

                                </Grid>

                            </Grid>

                        </Grid>

                    </Border>

                    <!-- ПОЛЕ ПАРОЛЯ -->
                    <Border Background="#242429"
                            BorderBrush="#34343C"
                            BorderThickness="1"
                            CornerRadius="14"
                            Height="52"
                            Width="440"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="🔒"
                                       FontSize="17"
                                       Foreground="#9AA0AE"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <Grid Grid.Column="1" Margin="0,6,8,6">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Пароль"
                                           FontSize="10"
                                           Foreground="#7D8290"
                                           Margin="0,0,0,2"/>

                                <Grid Grid.Row="1" VerticalAlignment="Center">

                                    <PasswordBox x:Name="ПолеПароль"
                                                 Background="Transparent"
                                                 Foreground="White"
                                                 CaretBrush="White"
                                                 BorderThickness="0"
                                                 FontSize="15"
                                                 Padding="0"
                                                 VerticalContentAlignment="Center"/>

                                    <TextBox x:Name="ПолеПарольВидимый"
                                             Background="Transparent"
                                             Foreground="White"
                                             CaretBrush="White"
                                             BorderThickness="0"
                                             FontSize="15"
                                             Padding="0"
                                             VerticalContentAlignment="Center"
                                             Visibility="Collapsed"/>

                                </Grid>

                            </Grid>

                            <Button x:Name="КнопкаПоказатьПароль"
                                    Grid.Column="2"
                                    Content="👁"
                                    FontSize="15"
                                    Foreground="#9AA0AE"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ТекстоваяКнопка}"
                                    Click="ПереключитьВидимостьПароля_Click"/>

                        </Grid>

                    </Border>

                    <Button Content="Забыли пароль?"
                            Style="{StaticResource ТекстоваяКнопка}"
                            Foreground="White"
                            FontSize="12"
                            Margin="0,4,0,22"
                            Click="ЗабылиПароль_Click"/>

                    <Button x:Name="КнопкаВойти"
                            Content="ВОЙТИ"
                            Height="46"
                            Width="440"
                            HorizontalAlignment="Center"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="White"
                            Cursor="Hand"
                            Click="Войти_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid RenderTransformOrigin="0.5,0.5">

                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="МасштабКнопки" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>

                                    <Border x:Name="ФонКнопки"
                                            CornerRadius="23"
                                            Background="#E5142F"/>

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Grid>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ФонКнопки" Property="Background" Value="#FF2A47"/>
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">

                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="МасштабКнопки"
                                                                     Storyboard.TargetProperty="ScaleX"
                                                                     To="0.95" Duration="0:0:0.08"/>
                                                    <DoubleAnimation Storyboard.TargetName="МасштабКнопки"
                                                                     Storyboard.TargetProperty="ScaleY"
                                                                     To="0.95" Duration="0:0:0.08"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>

                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="МасштабКнопки"
                                                                     Storyboard.TargetProperty="ScaleX"
                                                                     To="1" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="МасштабКнопки"
                                                                     Storyboard.TargetProperty="ScaleY"
                                                                     To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>
                        </Button.Template>

                    </Button>

                    <TextBlock x:Name="ТекстОшибка"
                               Margin="0,12,0,0"
                               Foreground="#FF5C5C"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               TextAlignment="Center"/>

                    <StackPanel HorizontalAlignment="Center"
                                Margin="0,26,0,0">

                        <TextBlock Text="Если у вас ещё нет аккаунта"
                                   Foreground="White"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>

                        <Button Content="Зарегистрируйтесь"
                                Style="{StaticResource ТекстоваяКнопка}"
                                Foreground="#E5142F"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Margin="0,4,0,0"
                                Click="Зарегистрироваться_Click"/>

                    </StackPanel>

                    <Button x:Name="Обслуживание"
                            Content="Обслуживание"
                            Style="{StaticResource ТекстоваяКнопка}"
                            Foreground="#4A4A52"
                            FontSize="11"
                            Margin="0,40,0,0"
                            Click="Обслуживание_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- СЛОЙ 3 — НАЗВАНИЕ ПК -->
        <TextBlock x:Name="ИмяПК"
                   Text="ПК"
                   FontSize="120"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="34,20,0,0"
                   IsHitTestVisible="False"/>

        <!-- СЛОЙ 4 — ЧАСЫ, ВПРИТЫК К ПРАВОМУ КРАЮ -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,0,26"
                CornerRadius="14,0,0,14"
                BorderBrush="#26FFFFFF"
                BorderThickness="1,1,0,1"
                Background="#4D050505"
                Padding="42,20"
                IsHitTestVisible="False">

            <TextBlock x:Name="Часы"
                       Text="00:00"
                       FontSize="78"
                       FontWeight="Bold"
                       Foreground="White"/>

        </Border>

        <!-- СЛОЙ 5 — ВИДЕО-ЭФФЕКТ (пепел/угли) — поверх панели входа и
             кнопок. IsHitTestVisible="False" — клики проходят сквозь него. -->
        <MediaElement x:Name="ЭффектВидео"
                      Stretch="UniformToFill"
                      Opacity="0.4"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      IsMuted="True"
                      Volume="0"
                      IsHitTestVisible="False"
                      MediaEnded="ЭффектВидео_MediaEnded"
                      MediaFailed="ЭффектВидео_MediaFailed"/>

    </Grid>

</Window>