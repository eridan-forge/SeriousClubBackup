<Window x:Class="серьёзный.ЭкранКлуба.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        
        Background="#0F172A"
        ShowInTaskbar="False">

    <Grid>

        <Border Width="420"
                Padding="28"
                CornerRadius="20"
                Background="#182235"
                BorderBrush="#24324B"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock x:Name="НазваниеКлуба"
                           Text="Серьёзный"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="НомерПК"
                           Text="ПК-07"
                           Margin="0,6,0,0"
                           FontSize="15"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="ГлавныйТекст"
                           Margin="0,20,0,0"
                           Text="Войдите в аккаунт"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Center"/>

                <StackPanel Margin="0,20,0,0">

                    <TextBlock Text="Номер телефона"
                               Foreground="#CBD5E1"
                               FontSize="13"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="ПолеТелефон"
                             Height="38"
                             FontSize="15"
                             MaxLength="18"
                             Background="#0F172A"
                             Foreground="White"
                             BorderBrush="#334155"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             TextChanged="ПолеТелефон_TextChanged"/>

                </StackPanel>

                <StackPanel Margin="0,14,0,0">

                    <TextBlock Text="Пароль"
                               Foreground="#CBD5E1"
                               FontSize="13"
                               Margin="0,0,0,5"/>

                    <PasswordBox x:Name="ПолеПароль"
                                 Height="38"
                                 FontSize="15"
                                 Background="#0F172A"
                                 Foreground="White"
                                 BorderBrush="#334155"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"/>

                </StackPanel>

                <Button x:Name="КнопкаВойти"
                        Content="Войти"
                        Height="40"
                        Margin="0,18,0,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Войти_Click"/>

                <TextBlock x:Name="ТекстОшибка"
                           Margin="0,12,0,0"
                           Foreground="#EF4444"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           TextAlignment="Center"/>

                <TextBlock x:Name="Часы"
                           Margin="0,24,0,0"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#38BDF8"
                           HorizontalAlignment="Center"/>

                <Button x:Name="Обслуживание"
                        Margin="0,22,0,0"
                        Width="150"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#475569"
                        FontSize="12"
                        Cursor="Hand"
                        Content="Обслуживание"
                        HorizontalAlignment="Center"
                        Click="Обслуживание_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>