<Window x:Class="серьёзный.ЭкранКлуба.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="Black"
        ShowInTaskbar="False">

    <Window.Resources>

        <SolidColorBrush x:Key="ОгненнаяРамкаКисть" x:Name="ОгненнаяРамкаКисть" Color="#5C1826"/>

    </Window.Resources>

    <Grid x:Name="Корень">

        <!-- СЛОЙ 1 — ФОНОВОЕ ВИДЕО (дракон, 10 минут, цикл). -->
        <MediaElement x:Name="ФонВидео"
                      Stretch="UniformToFill"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      IsMuted="True"
                      Volume="0"
                      IsHitTestVisible="False"
                      MediaEnded="ФонВидео_MediaEnded"
                      MediaFailed="ФонВидео_MediaFailed">

            <MediaElement.Effect>
                <BlurEffect Radius="3.5"/>
            </MediaElement.Effect>

        </MediaElement>

        <!-- СЛОЙ 2 — ВИДЕО-ЭФФЕКТ (пепел/угли).
             MP4 не умеет альфа-канал — непрозрачный фон этого видео
             физически не может "прорезаться", независимо от порядка
             слоёв. Opacity ниже — рабочий компромисс: дракон просвечивает
             сквозь полупрозрачный пепел. Настоящий screen-блендинг
             (чтобы чёрное вообще не участвовало) требует кастомный
             pixel shader — отдельная задача, если нужен именно он.
             Значение 0.4 — подбирай на глаз под конкретное видео. -->
        <MediaElement x:Name="ЭффектВидео"
                      Stretch="UniformToFill"
                      Opacity="0.4"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      IsMuted="True"
                      Volume="0"
                      IsHitTestVisible="False"
                      MediaEnded="ЭффектВидео_MediaEnded"
                      MediaFailed="ЭффектВидео_MediaFailed"/>

        <!-- СЛОЙ 3 — ЦЕНТРАЛЬНАЯ ПАНЕЛЬ ВХОДА. -->
        <Border x:Name="ПанельВхода"
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Margin="0"
                Background="#CC000000"
                BorderBrush="#33FFFFFF"
                BorderThickness="1,0,1,0">

            <StackPanel VerticalAlignment="Center" Margin="30,0">

                <!-- ЛОГОТИП "СЕРЬЁЗНЫЙ" ИЗ PNG.
                     Visibility="Collapsed" по умолчанию — пока код не
                     подтвердит, что logo.png реально загружен и обработан
                     (см. СделатьЧёрныйФонПрозрачным в .xaml.cs), фигура
                     скрыта. Раньше при отсутствии/незагруженном логотипе
                     тут был виден сплошной красный квадрат — Rectangle
                     без валидной маски просто заливался ЛогоЦвет целиком. -->
                <Rectangle x:Name="ЛогоФигура"
                           Height="80"
                           Margin="0,40,0,30"
                           Visibility="Collapsed">
                    <Rectangle.Fill>
                        <SolidColorBrush x:Name="ЛогоЦвет" Color="#E5142F"/>
                    </Rectangle.Fill>
                    <Rectangle.OpacityMask>
                        <ImageBrush x:Name="ЛогоМаска" Stretch="Uniform"/>
                    </Rectangle.OpacityMask>
                </Rectangle>

                <!-- ПОЛЕ ТЕЛЕФОНА -->
                <Border Background="#0D0D0D"
                        BorderBrush="{StaticResource ОгненнаяРамкаКисть}"
                        BorderThickness="1.6"
                        CornerRadius="10"
                        Height="44"
                        Margin="0,0,0,14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="📱"
                                   FontSize="17"
                                   Foreground="#B4123A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="ПолеТелефон"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 Foreground="White"
                                 CaretBrush="White"
                                 BorderThickness="0"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,10,0"
                                 TextChanged="ПолеТелефон_TextChanged"/>
                    </Grid>

                </Border>

                <!-- ПОЛЕ ПАРОЛЯ -->
                <Border Background="#0D0D0D"
                        BorderBrush="{StaticResource ОгненнаяРамкаКисть}"
                        BorderThickness="1.6"
                        CornerRadius="10"
                        Height="44"
                        Margin="0,0,0,8">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="🔒"
                                   FontSize="16"
                                   Foreground="#B4123A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <PasswordBox x:Name="ПолеПароль"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     Foreground="White"
                                     CaretBrush="White"
                                     BorderThickness="0"
                                     FontSize="15"
                                     VerticalContentAlignment="Center"
                                     Padding="0,0,6,0"/>

                        <TextBox x:Name="ПолеПарольВидимый"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 Foreground="White"
                                 CaretBrush="White"
                                 BorderThickness="0"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,6,0"
                                 Visibility="Collapsed"/>

                        <Button x:Name="КнопкаПоказатьПароль"
                                Grid.Column="2"
                                Content="👁"
                                FontSize="15"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#B4123A"
                                Cursor="Hand"
                                Click="ПереключитьВидимостьПароля_Click"/>
                    </Grid>

                </Border>

                <Button Content="Забыли пароль?"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#8C8C99"
                        FontSize="12"
                        Cursor="Hand"
                        Margin="0,0,0,20"
                        Click="ЗабылиПароль_Click"/>

                <Button x:Name="КнопкаВойти"
                        Content="Войти"
                        Height="42"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#B4123A"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Войти_Click"/>

                <TextBlock x:Name="ТекстОшибка"
                           Margin="0,12,0,0"
                           Foreground="#FF5C5C"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           TextAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,26,0,0">

                    <TextBlock Text="Ещё нет аккаунта? "
                               Foreground="#8C8C99"
                               FontSize="12"/>

                    <Button Content="Зарегистрируйтесь"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#E5142F"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Padding="0"
                            Click="Зарегистрироваться_Click"/>

                </StackPanel>

                <Button x:Name="Обслуживание"
                        Margin="0,40,0,0"
                        Height="26"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#4A4A52"
                        FontSize="11"
                        Cursor="Hand"
                        Content="Обслуживание"
                        Click="Обслуживание_Click"/>

            </StackPanel>

        </Border>

        <!-- СЛОЙ 4 — НАЗВАНИЕ ПК -->
        <TextBlock x:Name="ИмяПК"
                   Text="ПК"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#E5142F"
                   Opacity="0.55"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="34,26,0,0"
                   IsHitTestVisible="False"/>

        <!-- СЛОЙ 5 — ЧАСЫ -->
        <TextBlock x:Name="Часы"
                   Text="00:00"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#E5142F"
                   Opacity="0.7"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,34,26"
                   IsHitTestVisible="False"/>

    </Grid>

</Window>