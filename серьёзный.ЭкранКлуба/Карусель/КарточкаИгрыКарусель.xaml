<UserControl x:Class="серьёзный.ЭкранКлуба.Карусель.КарточкаИгрыКарусель"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360"
             Height="480">

    <UserControl.Resources>

        <!-- СТЕКЛЯННАЯ КРУГЛАЯ КНОПКА (★ / скрыть) -->
        <Style x:Key="СтеклоКруглаяКнопка" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Фон"
                                     Fill="#38FFFFFF"
                                     Stroke="#55FFFFFF"
                                     StrokeThickness="1.2">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="Black"
                                                       BlurRadius="10"
                                                       ShadowDepth="2"
                                                       Opacity="0.35"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Фон" Property="Fill" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Фон" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТЕКЛЯННАЯ КНОПКА "ВОЙТИ В ИГРУ" -->
        <Style x:Key="СтеклоКнопкаИграть" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Фон"
                                CornerRadius="14"
                                Background="#40FFFFFF"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1.3">
                            <Border.Effect>
                                <DropShadowEffect Color="#E5142F"
                                                   BlurRadius="18"
                                                   ShadowDepth="0"
                                                   Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Фон" Property="Background" Value="#55FFFFFF"/>
                                <Setter TargetName="Фон" Property="BorderBrush" Value="#E5142F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Фон" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- Корень: КарусельИгр управляет масштабом (глубина) и наклоном
         (имитация поворота) через МасштабКарточки/УголПоворота ниже -
         сама карточка не знает, где она в дуге. PlaneProjection тут
         СОЗНАТЕЛЬНО не используется - тип Projection недоступен в
         WPF на этой версии .NET (не портирован из .NET Framework),
         поэтому "поворот" карточки в дуге имитируется SkewTransform -
         тот же визуальный эффект cover-flow, но на обычных 2D
         трансформах, которые есть в WPF всегда. -->
    <Grid x:Name="Корень" RenderTransformOrigin="0.5,0.5">

        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Масштаб" ScaleX="1" ScaleY="1"/>
                <SkewTransform x:Name="Наклон" AngleY="0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Border x:Name="Оболочка" Background="#161119">

            <!-- Ручной скруглённый Clip вместо ClipToBounds: у
                 ClipToBounds область обрезки прямоугольная, углы
                 обложки просвечивали бы за пределы скруглённой рамки. -->
            <Border.Clip>
                <RectangleGeometry Rect="0,0,360,480" RadiusX="26" RadiusY="26"/>
            </Border.Clip>

            <Border.Effect>
                <DropShadowEffect Color="Black"
                                   BlurRadius="34"
                                   ShadowDepth="12"
                                   Direction="270"
                                   Opacity="0.55"/>
            </Border.Effect>

            <Grid>

                <!-- Обложка на весь размер карточки -->
                <Image x:Name="Обложка" Stretch="UniformToFill"/>

                <!-- Заглушка, если обложки нет -->
                <Grid x:Name="ЗаглушкаОбложки" Visibility="Collapsed">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#241419" Offset="0"/>
                            <GradientStop Color="#0F0B0D" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <TextBlock Text="🎮"
                               FontSize="90"
                               Opacity="0.28"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Тёмный градиент снизу — читаемость текста поверх ЛЮБОЙ обложки -->
                <Border VerticalAlignment="Bottom" Height="230">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#B3000000" Offset="0.55"/>
                            <GradientStop Color="#EE000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- МАТОВОЕ СТЕКЛО: настоящий блюр той же обложки + полупрозрачная
                     плёнка поверх - эффект не зависит от того, какие цвета у
                     конкретной игры. -->
                <Grid VerticalAlignment="Bottom" Height="176">

                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,360,176"/>
                    </Grid.Clip>

                    <Image x:Name="ОбложкаРазмытая"
                           Width="360"
                           Height="480"
                           Stretch="UniformToFill"
                           Opacity="0.5"
                           VerticalAlignment="Bottom">

                        <Image.CacheMode>
                            <BitmapCache/>
                        </Image.CacheMode>

                        <Image.Effect>
                            <BlurEffect Radius="28" KernelType="Gaussian"/>
                        </Image.Effect>

                    </Image>

                    <Border Background="#3AFFFFFF"/>

                    <Border VerticalAlignment="Top" Height="1.4" Background="#70FFFFFF"/>

                </Grid>

                <!-- Тонкая светлая рамка по краю всей карточки — "стеклянный" контур -->
                <Border BorderBrush="#40FFFFFF" BorderThickness="1.4" CornerRadius="26"/>

                <!-- Скрыть игру -->
                <Button x:Name="КнопкаСкрыть"
                        Style="{StaticResource СтеклоКруглаяКнопка}"
                        Content="🙈"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16"
                        ToolTip="Скрыть игру"
                        Click="КнопкаСкрыть_Click"/>

                <!-- В избранное -->
                <Button x:Name="КнопкаИзбранное"
                        Style="{StaticResource СтеклоКруглаяКнопка}"
                        Content="☆"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="16"
                        ToolTip="В избранное"
                        Click="КнопкаИзбранное_Click"/>

                <!-- Название / категория / вход в игру -->
                <StackPanel VerticalAlignment="Bottom" Margin="22,0,22,22">

                    <TextBlock x:Name="Название"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock x:Name="Категория"
                               FontSize="13"
                               Foreground="#D9D9DE"
                               Margin="0,3,0,14"/>

                    <Button x:Name="КнопкаИграть"
                            Style="{StaticResource СтеклоКнопкаИграть}"
                            Content="▶  Войти в игру"
                            Click="КнопкаИграть_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>