<UserControl x:Class="серьёзный.ЭкранКлуба.Карусель.КарточкаИгрыКарусель"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360"
             Height="480">

    <UserControl.Resources>

        <!-- СТЕКЛЯННАЯ КРУГЛАЯ КНОПКА (★ / скрыть) -->
        <Style x:Key="СтеклоКруглаяКнопка" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Фон"
                                     Fill="#38FFFFFF"
                                     Stroke="#55FFFFFF"
                                     StrokeThickness="1.2">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="Black"
                                                       BlurRadius="10"
                                                       ShadowDepth="2"
                                                       Opacity="0.35"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Фон" Property="Fill" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Фон" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТЕКЛЯННАЯ КНОПКА "ИГРАТЬ" — премиальный салатовый неон -->
        <Style x:Key="СтеклоКнопкаИграть" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Foreground" Value="#0B2E13"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Масштаб" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <Border x:Name="Фон"
                                    CornerRadius="16"
                                    Background="#5AE86B"
                                    BorderBrush="#B6FFC2"
                                    BorderThickness="1.4">
                                <Border.Effect>
                                    <DropShadowEffect Color="#7CFF6B"
                                                       BlurRadius="26"
                                                       ShadowDepth="0"
                                                       Opacity="0.6"/>
                                </Border.Effect>
                            </Border>

                            <!-- стеклянный блик сверху -->
                            <Border CornerRadius="16,16,0,0"
                                    VerticalAlignment="Top"
                                    Height="22"
                                    Margin="2,2,2,0"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#80FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Фон" Property="Background" Value="#7CFF6B"/>
                                <Setter TargetName="Фон" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#7CFF6B"
                                                          BlurRadius="40"
                                                          ShadowDepth="0"
                                                          Opacity="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Масштаб"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.96" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="Масштаб"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.96" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Масштаб"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Масштаб"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="Корень" RenderTransformOrigin="0.5,0.5">

        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Масштаб" ScaleX="1" ScaleY="1"/>
                <SkewTransform x:Name="Наклон" AngleY="0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Border x:Name="Оболочка"
                Background="#161119"
                CornerRadius="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Tag}">

            <Border.Clip>
                <RectangleGeometry x:Name="ГраницаОбрезки" Rect="0,0,360,480" RadiusX="28" RadiusY="28"/>
            </Border.Clip>

            <Border.Effect>
                <DropShadowEffect Color="Black"
                                   BlurRadius="34"
                                   ShadowDepth="12"
                                   Direction="270"
                                   Opacity="0.55"/>
            </Border.Effect>

            <Grid>

                <!-- ОБЛОЖКА НА ВСЮ КАРТОЧКУ -->
                <Image x:Name="Обложка" Stretch="UniformToFill"/>

                <!-- Заглушка, если обложки нет -->
                <Grid x:Name="ЗаглушкаОбложки" Visibility="Collapsed">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#241419" Offset="0"/>
                            <GradientStop Color="#0F0B0D" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <TextBlock Text="🎮"
                               FontSize="90"
                               Opacity="0.28"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Лёгкое затемнение сверху для читаемости иконок -->
                <Border VerticalAlignment="Top" Height="140" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#90000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Название поверх обложки, сверху -->
                <StackPanel VerticalAlignment="Top" Margin="20,18,20,0">
                    <TextBlock x:Name="Название"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="Категория"
                               FontSize="13"
                               Foreground="#E4E4E8"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Тонкая светлая рамка по краю всей карточки -->
                <Border BorderBrush="#40FFFFFF" BorderThickness="1.4" CornerRadius="28"/>

                <!-- Скрыть игру -->
                <Button x:Name="КнопкаСкрыть"
                        Style="{StaticResource СтеклоКруглаяКнопка}"
                        Content="🙈"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16,-70,0,0"
                        ToolTip="Скрыть игру"
                        Click="КнопкаСкрыть_Click"
                        Panel.ZIndex="5"/>

                <!-- В избранное -->
                <Button x:Name="КнопкаИзбранное"
                        Style="{StaticResource СтеклоКруглаяКнопка}"
                        Content="☆"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-70,16,0"
                        ToolTip="В избранное"
                        Click="КнопкаИзбранное_Click"
                        Panel.ZIndex="5"/>

                <!-- КНОПКА "ИГРАТЬ" — чуть ниже середины карточки, стеклянная, во всю ширину с отступами -->
                <Button x:Name="КнопкаИграть"
                        Style="{StaticResource СтеклоКнопкаИграть}"
                        Content="▶  ИГРАТЬ"
                        VerticalAlignment="Center"
                        Margin="24,240,24,0"
                        Click="КнопкаИграть_Click"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>