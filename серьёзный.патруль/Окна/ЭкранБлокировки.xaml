<Window x:Class="серьёзный.Патруль.Окна.ЭкранБлокировки"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#0F172A">

    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock
                Text="СЕРЬЁЗНЫЙ"
                FontSize="54"
                FontWeight="Bold"
                Foreground="White"
                HorizontalAlignment="Center"/>

            <TextBlock
                x:Name="ТекстПК"
                Text="PC-00"
                FontSize="28"
                Foreground="#93C5FD"
                Margin="0,15,0,25"
                HorizontalAlignment="Center"/>

            <TextBlock
                Text="СЕАНС ЗАВЕРШЁН"
                FontSize="36"
                FontWeight="Bold"
                Foreground="#F87171"
                HorizontalAlignment="Center"/>

            <TextBlock
                Text="Обратитесь к администратору."
                FontSize="20"
                Foreground="#CBD5E1"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>