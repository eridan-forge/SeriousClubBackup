<Window x:Class="серьёзный.ЭкранКлуба.ИнфоОкно"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        Height="230"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Topmost="True">

    <Border CornerRadius="18"
            BorderBrush="#5C1826"
            BorderThickness="1.4"
            Background="#050505"
            Padding="28">

        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">

            <TextBlock x:Name="ТекстЗаголовок"
                       Text="Уведомление"
                       FontSize="19"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,14"/>

            <TextBlock x:Name="ТекстСообщения"
                       Text=""
                       FontSize="14"
                       Foreground="#D8D8DC"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,24"/>

            <Button Content="Понятно"
                    Height="40"
                    Width="150"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="Закрыть_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="20" Background="#E5142F">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

            </Button>

        </StackPanel>

    </Border>

</Window>