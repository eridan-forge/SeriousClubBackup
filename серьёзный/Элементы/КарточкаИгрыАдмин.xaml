<UserControl x:Class="серьёзный.Элементы.КарточкаИгрыАдмин"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="320"
             Width="190">

    <Border Background="#1F2937"
            CornerRadius="16"
            BorderBrush="#334155"
            BorderThickness="1"
            Margin="6">

        <StackPanel>

            <Image x:Name="Обложка"
                   Height="185"
                   Stretch="UniformToFill"/>

            <TextBlock x:Name="Название"
                       Margin="10,8,10,0"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock x:Name="Категория"
                       Margin="10,4,10,10"
                       Foreground="#94A3B8"/>

            <Button Content="Редактировать"
                    Margin="10,0,10,10"
                    Click="Редактировать_Click"/>

        </StackPanel>

    </Border>

</UserControl>