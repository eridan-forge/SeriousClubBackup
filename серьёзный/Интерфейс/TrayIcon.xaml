<tb:TaskbarIcon
    x:Class="серьёзный.Интерфейс.TrayIcon"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="http://www.hardcodet.net/taskbar"

   
    ToolTipText="Серьёзный — сервер клуба">

    <tb:TaskbarIcon.ContextMenu>

        <ContextMenu>

            <MenuItem
                Header="Открыть"
                Click="Открыть_Click"/>

            <Separator/>

            <MenuItem
                Header="Выход"
                Click="Выход_Click"/>

        </ContextMenu>

    </tb:TaskbarIcon.ContextMenu>

</tb:TaskbarIcon>