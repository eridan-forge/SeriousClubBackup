<UserControl x:Class="серьёзный.Панели.ПанельНастройкиПК"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <DockPanel Margin="0,0,0,16">

            <Button DockPanel.Dock="Left"
                    Width="90"
                    Height="34"
                    Content="← Назад"
                    Click="Назад_Click"/>

            <TextBlock Text="Настройка ПК"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource CrystalTextBrush}"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"/>

        </DockPanel>

        <Border Style="{StaticResource CrystalCard}">

            <Grid MinHeight="420">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="Список"
                         DisplayMemberPath="Название"
                         Background="Transparent"
                         SelectionChanged="Список_SelectionChanged"/>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">

                    <UniformGrid Columns="3" Margin="0,0,0,8">
                        <TextBox x:Name="ПолеId" ToolTip="Id (число)"/>
                        <TextBox x:Name="ПолеНазвание" ToolTip="Название"/>
                        <TextBox x:Name="ПолеMAC" ToolTip="MAC-адрес"/>
                    </UniformGrid>

                    <UniformGrid Columns="3">
                        <Button Content="➕ Добавить" Click="Добавить_Click"/>
                        <Button Content="💾 Сохранить" Click="Сохранить_Click"/>
                        <Button Content="🗑 Удалить" Click="Удалить_Click"/>
                    </UniformGrid>

                </StackPanel>

            </Grid>

        </Border>

    </StackPanel>

</UserControl>