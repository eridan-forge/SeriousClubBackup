<UserControl x:Class="серьёзный.Панели.ПанельИстории"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <DockPanel Margin="0,0,0,16">

            <Button DockPanel.Dock="Left"
                    Width="90"
                    Height="34"
                    Content="← Назад"
                    Click="Назад_Click"/>

            <TextBlock Text="История клуба"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource CrystalTextBrush}"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"/>

        </DockPanel>

        <Border Style="{StaticResource CrystalCard}">

            <Grid MinHeight="500">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">

                    <TextBox x:Name="ПолеПоиска"
                             Width="260"
                             Height="34"
                             VerticalContentAlignment="Center"
                             TextChanged="Поиск_TextChanged"/>

                    <ComboBox x:Name="Фильтр"
                              Width="150"
                              Height="34"
                              Margin="10,0,0,0"
                              SelectionChanged="Фильтр_SelectionChanged">

                        <ComboBoxItem Content="Все" IsSelected="True"/>
                        <ComboBoxItem Content="Сегодня"/>
                        <ComboBoxItem Content="Неделя"/>
                        <ComboBoxItem Content="Месяц"/>
                    </ComboBox>

                </StackPanel>

                <DataGrid x:Name="Таблица"
                          Grid.Row="1"
                          Margin="0,16,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Background="#1E293B"
                          Foreground="White"
                          BorderThickness="0"
                          MouseDoubleClick="ОткрытьАккаунт">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ПК"
                                            Binding="{Binding КомпьютерId}"/>

                        <DataGridTextColumn Header="Игрок"
                                            Binding="{Binding Игрок}"/>

                        <DataGridTextColumn Header="Начало"
                                            Binding="{Binding Начало}"/>

                        <DataGridTextColumn Header="Отключение"
                                            Binding="{Binding Отключение}"/>

                        <DataGridTextColumn Header="Сыграно"
                                            Binding="{Binding Сыграно}"/>

                        <DataGridTextColumn Header="Возвращено"
                                            Binding="{Binding Возвращено}"/>

                        <DataGridTextColumn Header="Стоимость"
                                            Binding="{Binding Стоимость}"/>

                    </DataGrid.Columns>

                </DataGrid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">

                    <Button x:Name="УдалитьЗапись"
                            Content="Удалить запись"
                            Width="150"
                            Margin="0,0,8,0"/>

                    <Button x:Name="ОчиститьВсё"
                            Content="Очистить весь архив"
                            Width="170"/>

                </StackPanel>

            </Grid>

        </Border>

    </StackPanel>

</UserControl>