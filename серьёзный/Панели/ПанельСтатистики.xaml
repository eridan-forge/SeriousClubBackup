<UserControl x:Class="серьёзный.Панели.ПанельСтатистики"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,20">

            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Left" Width="90" Height="34"
                    Content="← Назад" Click="Назад_Click"/>
                <TextBlock Text="Статистика клуба" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource CrystalTextBrush}"
                       Margin="16,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- ПЕРИОД -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="С" Foreground="{DynamicResource CrystalTextBrush}" VerticalAlignment="Center"/>
                <DatePicker x:Name="ДатаОт" Margin="8,0,20,0"/>
                <TextBlock Text="По" Foreground="{DynamicResource CrystalTextBrush}" VerticalAlignment="Center"/>
                <DatePicker x:Name="ДатаДо" Margin="8,0,20,0"/>
                <Button Content="Обновить" Width="110" Height="34" Click="Обновить_Click"/>
            </StackPanel>

            <!-- ИТОГИ -->
            <UniformGrid Columns="4" Margin="0,20,0,20">
                <Border Style="{StaticResource CrystalCard}">
                    <StackPanel>
                        <TextBlock Text="Выручка" Foreground="{DynamicResource CrystalTextBrush}"/>
                        <TextBlock x:Name="Выручка" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource CrystalTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CrystalCard}">
                    <StackPanel>
                        <TextBlock Text="Сеансов" Foreground="{DynamicResource CrystalTextBrush}"/>
                        <TextBlock x:Name="Сеансы" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource CrystalTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CrystalCard}">
                    <StackPanel>
                        <TextBlock Text="Игровое время" Foreground="{DynamicResource CrystalTextBrush}"/>
                        <TextBlock x:Name="ИгровоеВремя" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource CrystalTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CrystalCard}">
                    <StackPanel>
                        <TextBlock Text="Средний чек" Foreground="{DynamicResource CrystalTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="СреднийЧек" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource CrystalTextBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- РУЧНАЯ КОРРЕКТИРОВКА -->
            <Border Style="{StaticResource CrystalCard}" Margin="0,0,0,16">
                <StackPanel>

                    <TextBlock Text="Ручная корректировка" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource CrystalTextBrush}"/>
                    <TextBlock Text="Значения вводятся положительными. Кнопка «Добавить» прибавляет их к статистике, «Вычесть» — отнимает."
                           Foreground="{DynamicResource CrystalTextMutedBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,14"/>

                    <WrapPanel>

                        <StackPanel Width="170" Margin="0,0,12,12">
                            <TextBlock Text="Дата" Foreground="{DynamicResource CrystalTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <DatePicker x:Name="ДатаКорректировки" Height="44"/>
                        </StackPanel>

                        <StackPanel Width="140" Margin="0,0,12,12">
                            <TextBlock Text="Деньги, ₽" Foreground="{DynamicResource CrystalTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ПолеКорректировкаДенег" Text="0"/>
                        </StackPanel>

                        <StackPanel Width="140" Margin="0,0,12,12">
                            <TextBlock Text="Сеансы, шт." Foreground="{DynamicResource CrystalTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ПолеКорректировкаСеансов" Text="0"/>
                        </StackPanel>

                        <StackPanel Width="140" Margin="0,0,12,12">
                            <TextBlock Text="Игровые минуты" Foreground="{DynamicResource CrystalTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ПолеКорректировкаМинут" Text="0"/>
                        </StackPanel>

                        <StackPanel Width="280" Margin="0,0,12,12">
                            <TextBlock Text="Примечание" Foreground="{DynamicResource CrystalTextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ПолеПримечание"/>
                        </StackPanel>

                    </WrapPanel>

                    <WrapPanel>
                        <Button Content="➕ Добавить" Width="170" Height="42" Margin="0,0,12,8"
                            Click="ДобавитьКорректировку_Click"/>
                        <Button Content="➖ Вычесть" Width="170" Height="42" Margin="0,0,12,8"
                            Click="ВычестьКорректировку_Click"/>
                        <Button Content="🗑 Удалить все за период" Width="230" Height="42" Margin="0,0,12,8"
                            Click="УдалитьКорректировки_Click"/>
                    </WrapPanel>

                    <TextBlock Text="Корректировки за выбранный период"
                           Foreground="{DynamicResource CrystalTextBrush}"
                           FontWeight="SemiBold" Margin="0,14,0,8"/>

                    <DataGrid x:Name="ТаблицаКорректировок" Height="190"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          Background="#1E293B" Foreground="White" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Width="110"
                                            Binding="{Binding Дата, StringFormat=dd.MM.yyyy}"/>
                            <DataGridTextColumn Header="Деньги" Width="110"
                                            Binding="{Binding Выручка, StringFormat={}{0:+0.##;-0.##;0} ₽}"/>
                            <DataGridTextColumn Header="Сеансы" Width="90"
                                            Binding="{Binding Сеансов, StringFormat={}{0:+0;-0;0}}"/>
                            <DataGridTextColumn Header="Минуты" Width="90"
                                            Binding="{Binding Минут, StringFormat={}{0:+0;-0;0}}"/>
                            <DataGridTextColumn Header="Примечание" Width="*"
                                            Binding="{Binding Примечание}"/>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑" Width="40" Height="28"
                                            Tag="{Binding Id}"
                                            Click="УдалитьОдну_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

            <!-- ПО ПК -->
            <TextBlock Text="По компьютерам" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource CrystalTextBrush}" Margin="0,0,0,8"/>

            <DataGrid x:Name="Таблица" Height="260" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ПК" Binding="{Binding КомпьютерId}"/>
                    <DataGridTextColumn Header="Сеансов" Binding="{Binding Сеансов}"/>
                    <DataGridTextColumn Header="Выручка" Binding="{Binding Выручка, StringFormat={}{0:0.##} ₽}"/>
                    <DataGridTextColumn Header="Игровое время" Binding="{Binding ИгровоеВремя}"/>
                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>
    </ScrollViewer>

</UserControl>