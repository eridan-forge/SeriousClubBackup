<UserControl x:Class="серьёзный.Панели.ПанельСтатистики"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <DockPanel Margin="0,0,0,16">

            <Button DockPanel.Dock="Left"
                    Width="90"
                    Height="34"
                    Content="← Назад"
                    Click="Назад_Click"/>

            <TextBlock Text="Статистика клуба"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource CrystalTextBrush}"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"/>

        </DockPanel>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="С" Foreground="{DynamicResource CrystalTextBrush}" VerticalAlignment="Center"/>
                <DatePicker x:Name="ДатаОт" Margin="8,0,20,0"/>
                <TextBlock Text="По" Foreground="{DynamicResource CrystalTextBrush}" VerticalAlignment="Center"/>
                <DatePicker x:Name="ДатаДо" Margin="8,0,20,0"/>
                <Button Content="Обновить" Click="Обновить_Click"/>
            </StackPanel>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,20,0,20">
                <Border Style="{StaticResource CrystalCard}">
                    <StackPanel>
                        <TextBlock Text="Выручка" Foreground="{DynamicResource CrystalTextBrush}"/>
                        <TextBlock x:Name="Выручка" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource CrystalTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CrystalCard}">
                    <StackPanel>
                        <TextBlock Text="Сеансов" Foreground="{DynamicResource CrystalTextBrush}"/>
                        <TextBlock x:Name="Сеансы" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource CrystalTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CrystalCard}">
                    <StackPanel>
                        <TextBlock Text="Игровое время" Foreground="{DynamicResource CrystalTextBrush}"/>
                        <TextBlock x:Name="ИгровоеВремя" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource CrystalTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CrystalCard}">
                    <StackPanel>
                        <TextBlock Text="Средний чек" Foreground="{DynamicResource CrystalTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="СреднийЧек" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource CrystalTextBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Style="{StaticResource CrystalCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Ручная корректировка" Foreground="{DynamicResource CrystalTextBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ПолеКорректировкаДенег" Text="0" Margin="0,0,8,0"/>
                        <TextBox x:Name="ПолеКорректировкаСеансов" Grid.Column="1" Text="0" Margin="0,0,8,0"/>
                        <TextBox x:Name="ПолеКорректировкаМинут" Grid.Column="2" Text="0" Margin="0,0,8,0"/>
                        <TextBox x:Name="ПолеПримечание" Grid.Column="3" Margin="0,0,8,0"/>
                        <Button Grid.Column="4" Content="Применить" Click="ПрименитьКорректировку_Click" Margin="0"/>
                    </Grid>
                    <TextBlock Text="Деньги • сеансы • игровые минуты • примечание" Foreground="#94A3B8" FontSize="11" Margin="0,8,0,0"/>
                    <Button Content="Удалить корректировки за период" Click="УдалитьКорректировки_Click" Margin="0,12,0,0" Width="240" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="3" x:Name="Таблица" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ПК" Binding="{Binding КомпьютерId}"/>
                    <DataGridTextColumn Header="Сеансов" Binding="{Binding Сеансов}"/>
                    <DataGridTextColumn Header="Выручка" Binding="{Binding Выручка, StringFormat={}{0:0.##} ₽}"/>
                    <DataGridTextColumn Header="Игровое время" Binding="{Binding ИгровоеВремя}"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

    </StackPanel>

</UserControl>