<UserControl x:Class="серьёзный.Панели.ПанельТемВхода"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Left" Width="90" Height="34" Content="← Назад" Click="Назад_Click"/>
            <TextBlock Text="Тема экрана входа" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource CrystalTextBrush}"
                       Margin="16,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Style="{StaticResource CrystalCard}">
            <StackPanel MinHeight="260">

                <TextBlock Text="Тема — это папка в Темы\ с файлами bg.mp4 / fg.mp4 / logo.png"
                           Foreground="{DynamicResource CrystalTextMutedBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <ComboBox x:Name="СписокТем" Height="36" DisplayMemberPath="Id" Margin="0,0,0,18"/>

                <Button Content="🔄 Обновить список тем" Height="36" Margin="0,0,0,18" Click="Обновить_Click"/>

                <TextBlock Text="Применить к:" Foreground="{DynamicResource CrystalTextBrush}" Margin="0,0,0,8"/>

                <UniformGrid Columns="2">
                    <Button Content="🖥 Текущему выбранному ПК" Height="42" Margin="0,0,8,0" Click="ПрименитьВыбранному_Click"/>
                    <Button Content="🌐 Всем ПК клуба" Height="42" Click="ПрименитьВсем_Click"/>
                </UniformGrid>

                <TextBlock x:Name="ТекстСтатуса" Margin="0,16,0,0"
                           Foreground="{DynamicResource CrystalTextMutedBrush}" TextWrapping="Wrap"/>

            </StackPanel>
        </Border>

    </StackPanel>

</UserControl>