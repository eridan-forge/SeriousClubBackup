<UserControl x:Class="серьёзный.Панели.ПанельНастройкиМагазина"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <DockPanel Margin="0,0,0,16">

            <Button DockPanel.Dock="Left"
                    Width="90"
                    Height="34"
                    Content="← Назад"
                    Click="Назад_Click"/>

            <TextBlock Text="Настройки магазина"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource CrystalTextBrush}"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"/>

        </DockPanel>

        <Grid MinHeight="560">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#172033"
                    CornerRadius="18"
                    Padding="12">

                <DockPanel>

                    <Button x:Name="ДобавитьРаздел"
                            DockPanel.Dock="Bottom"
                            Height="40"
                            Margin="0,12,0,0"
                            Content="+ Раздел"/>

                    <ListBox x:Name="СписокРазделов"
                             Background="Transparent"
                             BorderThickness="0"/>

                </DockPanel>

            </Border>

            <Border Grid.Column="1"
                    Margin="18,0,0,0"
                    Background="#172033"
                    CornerRadius="18"
                    Padding="16">

                <DockPanel>

                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal">

                        <Button x:Name="ДобавитьТовар"
                                Width="150"
                                Height="40"
                                Content="+ Товар"/>

                        <CheckBox x:Name="ПоказатьМагазин"
                                  Margin="24,10,0,0"
                                  Foreground="White"
                                  Content="Показывать магазин игрокам"
                                  Checked="ПоказатьМагазин_Changed"
                                  Unchecked="ПоказатьМагазин_Changed"/>

                    </StackPanel>

                    <ScrollViewer Margin="0,16,0,0">

                        <WrapPanel x:Name="ПанельТоваров"/>

                    </ScrollViewer>

                </DockPanel>

            </Border>

        </Grid>

    </StackPanel>

</UserControl>