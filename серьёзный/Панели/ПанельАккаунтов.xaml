<UserControl x:Class="серьёзный.Панели.ПанельАккаунтов"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <DockPanel Margin="0,0,0,16">

            <Button DockPanel.Dock="Left"
                    Width="90"
                    Height="34"
                    Content="← Назад"
                    Click="Назад_Click"/>

            <TextBlock Text="Аккаунты"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource CrystalTextBrush}"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"/>

        </DockPanel>

        <Border Style="{StaticResource CrystalCard}">

            <Grid MinHeight="480">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">

                    <TextBox x:Name="ПолеПоиска"
                             Width="260"
                             Height="34"
                             VerticalContentAlignment="Center"
                             Background="#1E293B"
                             Foreground="White"
                             BorderBrush="#334155"
                             CaretBrush="White"
                             Padding="8,0"
                             TextChanged="Поиск_TextChanged"/>

                    <Button Content="➕ Новый аккаунт"
                            Width="170"
                            Height="34"
                            Margin="10,0,0,0"
                            Click="Создать_Click"/>

                    <Button Content="💬 Написать"
                            Width="130"
                            Height="34"
                            Margin="10,0,0,0"
                            Click="Написать_Click"/>

                </StackPanel>

                <DataGrid x:Name="Таблица"
                          Grid.Row="1"
                          Margin="0,16,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Background="#1E293B"
                          Foreground="White"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          MouseDoubleClick="ОткрытьАккаунт">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Имя"
                                            Width="200"
                                            Binding="{Binding Имя}"/>

                        <DataGridTextColumn Header="Телефон"
                                            Width="160"
                                            Binding="{Binding ТелефонОтображаемый}"/>

                        <DataGridTextColumn Header="Осталось"
                                            Width="110"
                                            Binding="{Binding ОсталосьСтрокой}"/>

                        <DataGridTextColumn Header="Сыграно"
                                            Width="120"
                                            Binding="{Binding ВсегоСыграно}"/>

                        <DataGridTextColumn Header="Сеансов"
                                            Width="90"
                                            Binding="{Binding ВсегоСеансов}"/>

                        <DataGridTextColumn Header="Последний сеанс"
                            Width="*"
                            Binding="{Binding ПоследнийСеанс}"/>

                        <DataGridTemplateColumn Header="Чат" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="💬"
                            Width="40"
                            Height="30"
                            Tag="{Binding}"
                            Click="ОткрытьЧат_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Пароль" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🔑"
                            Width="40"
                            Height="30"
                            Tag="{Binding}"
                            Click="СброситьПароль_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </StackPanel>

</UserControl>