<UserControl x:Class="серьёзный.Панели.ПанельВопросовИгр"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Left" Width="90" Height="34" Content="← Назад" Click="Назад_Click"/>
            <TextBlock Text="Вопросы игроков"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource CrystalTextBrush}"
                       Margin="16,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Style="{StaticResource CrystalCard}">
            <Grid MinHeight="500">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <CheckBox x:Name="ФлагТолькоБезОтвета" Content="Только без ответа"
                          IsChecked="True" Foreground="{DynamicResource CrystalTextBrush}"
                          Checked="Обновить_Changed" Unchecked="Обновить_Changed"/>

                <DataGrid x:Name="Таблица" Grid.Row="1" Margin="0,14,0,14"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#1E293B" Foreground="White" BorderThickness="0"
                          SelectionChanged="Таблица_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Игра" Binding="{Binding GameName}" Width="160"/>
                        <DataGridTextColumn Header="Вопрос" Binding="{Binding Question}" Width="*"/>
                        <DataGridTextColumn Header="Спросил" Binding="{Binding AskedBy}" Width="140"/>
                        <DataGridTextColumn Header="Ответ" Binding="{Binding Answer}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2">
                    <TextBox x:Name="ПолеОтвета" AcceptsReturn="True" Height="70" TextWrapping="Wrap"/>
                    <Button Content="💾 Сохранить ответ" Width="180" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="СохранитьОтвет_Click"/>
                </StackPanel>

            </Grid>
        </Border>

    </StackPanel>

</UserControl>