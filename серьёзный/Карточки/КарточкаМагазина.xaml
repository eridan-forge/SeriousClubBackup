<UserControl x:Class="серьёзный.Карточки.КарточкаМагазина"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220"
             Height="360">

    <Border x:Name="Корень"
            Background="#1E293B"
            CornerRadius="18"
            Margin="10">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="210"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Margin="10"
                    CornerRadius="12"
                    ClipToBounds="True">

                <Grid>
                    

                    <Image x:Name="Фото"
                           Stretch="UniformToFill"/>
                        

                        <Border x:Name="Бейдж"
                            CornerRadius="8"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="8"
                            Visibility="Collapsed">
                            

                            <TextBlock x:Name="ТекстБейджа"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                   </Border>
                        

                </Grid>

            </Border>

            <StackPanel Grid.Row="1"
                        Margin="12,4">

                <TextBlock x:Name="Название"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock x:Name="Описание"
                           Margin="0,4,0,0"
                           Foreground="#CBD5E1"
                           TextWrapping="Wrap"
                           MaxHeight="42"/>

                <TextBlock x:Name="Цена"
                           Margin="0,10,0,12"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#38BDF8"/>

                <Button x:Name="Купить"
                        Height="38"
                        Content="Хочу купить"/>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>