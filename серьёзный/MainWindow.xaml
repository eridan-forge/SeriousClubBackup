<Window x:Class="серьёзный.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Серьёзный"
        Width="1400"
        Height="840"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CrystalMainBackgroundBrush}">

    <Window.Resources>

        <Style TargetType="Button"
               BasedOn="{StaticResource CrystalButton}"/>

        <Style TargetType="TextBox"
               BasedOn="{StaticResource CrystalTextBox}"/>

        <Style x:Key="CrystalSectionTitle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource CrystalTextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CrystalLabel"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource CrystalTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================= -->
        <!-- ЛЕВАЯ ПАНЕЛЬ                  -->
        <!-- ============================= -->

        <Border Grid.Column="0"
                Style="{StaticResource CrystalCard}"
                Margin="0,0,16,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>

                    <TextBlock
                        Text="СЕРЬЁЗНЫЙ"
                        Foreground="{DynamicResource CrystalTextBrush}"
                        FontSize="26"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="Управление клубом"
                        Foreground="{DynamicResource CrystalTextMutedBrush}"
                        FontSize="13"
                        Margin="0,2,0,18"/>

                    <TextBlock Text="Компьютер"
                               Style="{StaticResource CrystalLabel}"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="ВыборПК"
                              Height="42"
                              Margin="0,0,0,14"/>

                    <UniformGrid Columns="2"
                                 Margin="0,0,0,10">

                        <Grid>

                            <Button x:Name="КнопкаЧата"
        Content="💬 Чат"
        Click="Чат_Click"/>
                            <Border x:Name="ChatBadge"
            Width="22"
            Height="22"
            Background="#DC2626"
            CornerRadius="11"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="Collapsed">

                                <TextBlock x:Name="ChatCount"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="White"
                   FontWeight="Bold"/>

                            </Border>

                        </Grid>

                        <Button Content="✏ Имя в чате"
                                Click="ИмяАдминистратора_Click"/>

                    </UniformGrid>

                    <UniformGrid Columns="2"
                                 Margin="0,0,0,10">

                        <Button Content="👤 Аккаунты"
                                Click="Аккаунты_Click"/>

                        <Button Content="🕓 История"
                                Click="История_Click"/>
                        
                        <Button Content="⚙ Настройка ПК"
        Click="НастройкаПК_Click"/>

                    </UniformGrid>

                    <Border BorderBrush="{DynamicResource CrystalBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,14,0,14"/>

                    <Button Content="📊 Статистика клуба"
        Click="Статистика_Click"
        Margin="0,0,0,10"/>

                    <Grid>
                        <Button
    x:Name="КнопкаМагазин"
    Content="🛒 Магазин"
    Click="Магазин_Click"/>

                        <Border x:Name="BadgeЗаказов"
            Width="20"
            Height="20"
            CornerRadius="10"
            Background="#DC2626"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="Collapsed">

                            <TextBlock x:Name="BadgeText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="10"
                   Foreground="White"/>

                        </Border>

                    </Grid>

                    <Button x:Name="КнопкаИгры"
        Content="🎮 Игры"
        Height="42"
        Margin="0,8,0,0"
        Click="КнопкаИгры_Click"/>



                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,10,0,0">

                    <StackPanel>

                        <TextBlock
                            x:Name="ТекстПК"
                            Text="Подключённых ПК: 0"
                            Foreground="{DynamicResource CrystalTextSecondaryBrush}"
                            FontSize="14"
                            Margin="0,0,0,10"/>

                        <TextBlock
                            x:Name="ИнформацияПК"
                            Foreground="{DynamicResource CrystalTextSecondaryBrush}"
                            FontSize="13"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Border>

        <!-- ============================= -->
        <!-- ПРАВАЯ ЧАСТЬ                  -->
        <!-- ============================= -->

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- Выбранный ПК + таймер -->

                <Border Style="{StaticResource CrystalCard}">

                    <StackPanel>

                        <TextBlock
                            x:Name="НазваниеПК"
                            Text="Выбранный ПК"
                            Foreground="{DynamicResource CrystalTextBrush}"
                            FontSize="30"
                            FontWeight="Bold"/>

                        <TextBlock
                            x:Name="ТекстТаймера"
                            Text="00:00:00"
                            Foreground="{DynamicResource CrystalHighlightBrush}"
                            FontSize="48"
                            FontWeight="Bold"
                            Margin="0,6,0,0"/>

                        <TextBlock
                            x:Name="ТекстСостояния"
                            Text="Сервер готов"
                            Foreground="{DynamicResource CrystalTextMutedBrush}"
                            Margin="0,6,0,0"/>

                        <Border BorderBrush="{DynamicResource CrystalBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="0,20,0,16"/>

                        <TextBlock
                            Text="Все компьютеры"
                            Style="{StaticResource CrystalSectionTitle}"/>

                        <WrapPanel x:Name="СеткаПК"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Управление сеансом -->

                <Border Style="{StaticResource CrystalCard}"
                        Margin="0,16,0,0">

                    <StackPanel>

                        <TextBlock
                            Text="Управление сеансом"
                            Style="{StaticResource CrystalSectionTitle}"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
        Text="Минуты"
        Style="{StaticResource CrystalLabel}"/>

                            <TextBox
        x:Name="ПолеМинут"
        Grid.Column="1"
        Text="10"/>
                        </Grid>

                        <WrapPanel Margin="0,14,0,0">

                            <Button Content="▶ Начать"
            Click="НачатьСеанс_Click"/>

                            <Button Content="⏸ Пауза"
            Click="Пауза_Click"/>

                            <Button Content="▶ Продолжить"
            Click="Продолжить_Click"/>

                            <Button Content="➕ Время"
            Click="ДобавитьВремя_Click"/>

                            <Button Content="➖ Время"
            Click="УбавитьВремя_Click"/>

                            <Button Content="⏹ Завершить"
            Foreground="{DynamicResource CrystalDangerBrush}"
            Click="ЗавершитьСеанс_Click"/>

                            <Button Content="🔑 Пароль"
            Click="СменитьПароль_Click"/>

                            <Button Content="📝 Текст"
            Click="ИзменитьТекстЭкрана_Click"/>

                        </WrapPanel>

                    </StackPanel>

                </Border>

                <!-- Управление компьютером -->

                <Border Style="{StaticResource CrystalCard}"
                        Margin="0,16,0,0">

                    <StackPanel>

                        <TextBlock
                            Text="Управление компьютером"
                            Style="{StaticResource CrystalSectionTitle}"/>

                        <WrapPanel Margin="0,14,0,0">

                            <Button Content="⚡ Включить"
                                    Click="ВключитьПК_Click"/>

                            <Button Content="📡 Состояние"
                                    Click="ПолучитьСостояние_Click"/>

                            <Button Content="🔄 Перезагрузка"
                                    Click="Перезагрузить_Click"/>

                            <Button Content="⏻ Выключить"
                                    Foreground="{DynamicResource CrystalDangerBrush}"
                                    Click="Выключить_Click"/>

                            <Button Content="🔒 Блокировка"
                                    Click="Заблокировать_Click"/>

                            <Button Content="🔓 Разблокировать"
                                    Click="Разблокировать_Click"/>



                            <Button x:Name="КнопкаГолосовое"
        Content="🎤 Записать голос"
        Click="Голосовое_Click"/>

                        </WrapPanel>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>