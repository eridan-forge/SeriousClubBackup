                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>

                                <Button Width="96" Height="72" Margin="0,0,10,10" Click="СменитьПароль_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔑" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Пароль" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="96" Height="72" Margin="0,0,10,10" Click="ИзменитьТекстЭкрана_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="📝" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Текст экрана" FontSize="9" Margin="0,3,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="96" Height="72" Margin="0,0,10,10" Click="ДобавитьВремя_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="➕" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Время" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="96" Height="72" Margin="0,0,10,10" Click="УбавитьВремя_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="➖" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Время" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="96" Height="72" Margin="0,0,10,10" Click="КнопкаРазвлечения_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🎰" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Развлечения" FontSize="9" Margin="0,3,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                            </WrapPanel>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- ============================================ -->
            <!-- ПРАВАЯ КОЛОНКА: СПИСОК ПК -->
            <!-- ============================================ -->
            <Border Grid.Column="2"
                    Background="#0A0A0A"
                    BorderBrush="#2A151D"
                    BorderThickness="1,0,0,0">

                <DockPanel Margin="14">

                    <TextBlock DockPanel.Dock="Top"
                               Text="ВСЕ КОМПЬЮТЕРЫ"
                               Foreground="{DynamicResource CrystalTextMutedBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="4,0,0,10"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="СеткаПК"/>
                    </ScrollViewer>

                </DockPanel>

            </Border>

        </Grid>

    </Grid>

</Window>