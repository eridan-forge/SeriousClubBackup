<Window x:Class="серьёзный.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Серьёзный"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        AllowsTransparency="False"
        Background="{StaticResource ЧёрныйФонОкна}">

    <Window.Resources>

        <!-- ============================================ -->
        <!-- ФОН ОКНА: полностью чёрный -->
        <!-- ============================================ -->

        <LinearGradientBrush x:Key="ЧёрныйФонОкна" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#020202" Offset="0"/>
            <GradientStop Color="#0C0C0D" Offset="1"/>
        </LinearGradientBrush>

        <!-- ============================================ -->
        <!-- КАРБОН: диагональная плетёнка, чёрно-серая -->
        <!-- ============================================ -->

        <DrawingBrush x:Key="CarbonFiberBrush"
              TileMode="Tile"
              Viewport="0,0,14,14"
              ViewportUnits="Absolute"
              Stretch="None">

            <DrawingBrush.RelativeTransform>
                <RotateTransform Angle="45" CenterX="0.5" CenterY="0.5"/>
            </DrawingBrush.RelativeTransform>

            <DrawingBrush.Drawing>
                <DrawingGroup>

                    <GeometryDrawing Brush="#0A0A0A">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,14,14"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#161616">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,7,7"/>
                                <RectangleGeometry Rect="7,7,7,7"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#202020">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="7,0,7,7"/>
                                <RectangleGeometry Rect="0,7,7,7"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>


        <!-- ============================================ -->
        <!-- КРЕСТИК v2 -->
        <!-- ============================================ -->

        <Style x:Key="CloseGlyphButton" TargetType="Button">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">

                            <Grid.RenderTransform>
                                <RotateTransform x:Name="Rot" Angle="0"/>
                            </Grid.RenderTransform>

                            <Ellipse x:Name="Glow"
                             Width="30" Height="30"
                             Fill="#A9223F"
                             Opacity="0"/>

                            <Path x:Name="XPath"
                          Stroke="#E4A6B4"
                          StrokeThickness="2.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="-28,-28" IsClosed="False">
                                            <LineSegment Point="28,28"/>
                                        </PathFigure>
                                        <PathFigure StartPoint="28,-28" IsClosed="False">
                                            <LineSegment Point="-28,28"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>

                            <Ellipse x:Name="Circle"
                             Width="42" Height="42"
                             Fill="#0A0708"
                             Stroke="#5C1826"
                             StrokeThickness="1.6"/>

                            <Path Stroke="#E4A6B4"
                          StrokeThickness="2.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M -9,-9 L 9,9 M 9,-9 L -9,9"/>

                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">

                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="SpinIn">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Rot"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360"
                                                     Duration="0:0:1.3"
                                                     RepeatBehavior="Forever"/>

                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.75" Duration="0:0:0.25"/>

                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                     Storyboard.TargetProperty="Width"
                                                     To="70" Duration="0:0:0.4"/>

                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                     Storyboard.TargetProperty="Height"
                                                     To="70" Duration="0:0:0.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="SpinIn"/>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                     Storyboard.TargetProperty="Width"
                                                     To="30" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                     Storyboard.TargetProperty="Height"
                                                     To="30" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>

                                <Setter TargetName="Circle" Property="Stroke" Value="#FF3D66"/>
                                <Setter TargetName="XPath" Property="Stroke" Value="#FFD9E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ============================================ -->
        <!-- КВАДРАТ "В ОКНО" -->
        <!-- ============================================ -->

        <Style x:Key="RestoreGlyphButton" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="RestoreGlow"
                             Width="30" Height="30"
                             Fill="#7A1730"
                             Opacity="0"/>

                            <Rectangle x:Name="RestoreSquare"
                               Width="20" Height="20"
                               RadiusX="4" RadiusY="4"
                               Fill="#1A1116"
                               Stroke="#5C1826"
                               StrokeThickness="1.6"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RestoreGlow"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.55" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="RestoreGlow"
                                                     Storyboard.TargetProperty="Width"
                                                     To="46" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="RestoreGlow"
                                                     Storyboard.TargetProperty="Height"
                                                     To="46" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RestoreGlow"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="RestoreGlow"
                                                     Storyboard.TargetProperty="Width"
                                                     To="30" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="RestoreGlow"
                                                     Storyboard.TargetProperty="Height"
                                                     To="30" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="RestoreSquare" Property="Stroke" Value="#E4A6B4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- ОБЫЧНЫЕ КНОПКИ ОКНА: без MinWidth=140 -->
        <!-- (это и ломало левую колонку и WrapPanel'ы)   -->
        <!-- ============================================ -->

        <Style TargetType="Button">
            <Setter Property="Background" Value="#121013"/>
            <Setter Property="BorderBrush" Value="#242424"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E9C9D3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1C1620"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#B4224A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#050405"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource CrystalTextBox}"/>

        <Style x:Key="CrystalSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CrystalTextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CrystalLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CrystalTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- ШАПКА -->
        <!-- ============================================ -->

        <Border Grid.Row="0"
                Background="{StaticResource CarbonFiberBrush}"
                BorderBrush="#2A151D"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Шапка_MouseDown">

            <Grid Margin="24,0,18,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="СЕРЬЁЗНЫЙ"
                           FontSize="22"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           VerticalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush x:Name="ЗаголовокКисть" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF2E5C" Offset="0"/>
                            <GradientStop Color="#8A0F30" Offset="0.5"/>
                            <GradientStop Color="#FF2E5C" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <StackPanel Margin="18,0" HorizontalAlignment="Center">
                        <TextBlock Text="ВРЕМЯ" FontSize="10" Foreground="#7A2B3D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ТекстЧасыАдмин" Text="00:00:00" FontSize="18" FontWeight="Bold" Foreground="#E9C9D3" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Width="1" Height="34" Background="#3A222B" VerticalAlignment="Center"/>

                    <StackPanel Margin="18,0" HorizontalAlignment="Center">
                        <TextBlock Text="ПОДКЛЮЧЕНО ПК" FontSize="10" Foreground="#7A2B3D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ТекстПК" Text="0" FontSize="18" FontWeight="Bold" Foreground="#E9C9D3" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Width="1" Height="34" Background="#3A222B" VerticalAlignment="Center"/>

                    <StackPanel Margin="18,0" HorizontalAlignment="Center">
                        <TextBlock Text="АКТИВНЫХ СЕАНСОВ" FontSize="10" Foreground="#7A2B3D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ТекстАктивныеСеансы" Text="0" FontSize="18" FontWeight="Bold" Foreground="#E9C9D3" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Width="1" Height="34" Background="#3A222B" VerticalAlignment="Center"/>

                    <StackPanel Margin="18,0" HorizontalAlignment="Center">
                        <TextBlock Text="ЗАРАБОТАНО СЕГОДНЯ" FontSize="10" Foreground="#7A2B3D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ТекстВыручкаСегодня" Text="0 ₽" FontSize="18" FontWeight="Bold" Foreground="#FF3D66" HorizontalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource RestoreGlyphButton}" Margin="0,0,-4,0" Click="РазвернутьОкно_Click"/>
                    <Button Style="{StaticResource CloseGlyphButton}" Margin="0,0,-6,0" Click="Свернуть_Click"/>
                </StackPanel>

            </Grid>

        </Border>

        <!-- ============================================ -->
        <!-- ОСНОВНАЯ ОБЛАСТЬ -->
        <!-- ============================================ -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================ -->
            <!-- ЛЕВАЯ ИКОНОЧНАЯ ПАНЕЛЬ -->
            <!-- ============================================ -->
            <Border Grid.Column="0"
                    Background="#0A0A0A"
                    BorderBrush="#2A151D"
                    BorderThickness="0,0,1,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="0,14,0,14" HorizontalAlignment="Center">

                        <Grid Width="64" Height="64" Margin="0,0,0,10">
                            <Button x:Name="КнопкаЧата"
                                    Width="64" Height="64"
                                    ToolTip="Чат с игроком"
                                    Click="Чат_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="💬" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Чат" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Border x:Name="ChatBadge"
                                    Width="18" Height="18"
                                    Background="#DC2626"
                                    CornerRadius="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-4,-4,0"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <TextBlock x:Name="ChatCount"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="White"/>
                            </Border>
                        </Grid>

                        <Button Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="Имя администратора в чате"
                                Click="ИмяАдминистратора_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="✏" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Имя" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="Аккаунты игроков"
                                Click="Аккаунты_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Аккаунты" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="История сеансов"
                                Click="История_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🕓" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="История" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="Статистика клуба"
                                Click="Статистика_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Статистика" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Grid Width="64" Height="64" Margin="0,0,0,10">
                            <Button x:Name="КнопкаМагазин"
                                    Width="64" Height="64"
                                    ToolTip="Магазин"
                                    Click="Магазин_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🛒" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Магазин" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Border x:Name="BadgeЗаказов"
                                    Width="18" Height="18"
                                    Background="#DC2626"
                                    CornerRadius="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-4,-4,0"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <TextBlock x:Name="BadgeText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="White"/>
                            </Border>
                        </Grid>

                        <Button x:Name="КнопкаИгры"
                                Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="Игры на ПК"
                                Click="КнопкаИгры_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Игры" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="Настройка списка ПК"
                                Click="НастройкаПК_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="ПК" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#2A151D" Margin="6,6,6,10"/>

                        <Button Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="Резервная копия базы"
                                Click="РезервнаяКопия_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="💾" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Бэкап" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="Сжечь время всем аккаунтам"
                                Foreground="{DynamicResource CrystalDangerBrush}"
                                Click="СжечьВремя_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔥" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Сжечь" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- ============================================ -->
            <!-- ЦЕНТР: ВЫБРАННЫЙ ПК -->
            <!-- ============================================ -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="18">

                <StackPanel>

                    <ComboBox x:Name="ВыборПК" Visibility="Collapsed" SelectionChanged="ВыборПК_SelectionChanged"/>

                    <Border Style="{StaticResource CrystalCard}">

                        <StackPanel>

                            <TextBlock x:Name="НазваниеПК"
                                       Text="Выберите ПК справа"
                                       Foreground="{DynamicResource CrystalTextBrush}"
                                       FontSize="28"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="ИнформацияПК"
                                       Foreground="{DynamicResource CrystalTextMutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>

                            <TextBlock x:Name="ТекстТаймера"
                                       Text="00:00:00"
                                       Foreground="{DynamicResource CrystalHighlightBrush}"
                                       FontSize="56"
                                       FontWeight="Bold"
                                       Margin="0,14,0,0"/>

                            <TextBlock x:Name="ТекстСостояния"
                                       Text="Сервер готов"
                                       Foreground="{DynamicResource CrystalTextMutedBrush}"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource CrystalCard}" Margin="0,16,0,0">

                        <StackPanel>

                            <TextBlock Text="Быстрые действия" Style="{StaticResource CrystalSectionTitle}"/>

                            <WrapPanel Margin="0,10,0,0">

                                <Button Width="118" Height="80" Margin="0,0,10,10" Click="НачатьСеанс_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="▶" FontSize="22" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Начать" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="118" Height="80" Margin="0,0,10,10" Click="Пауза_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⏸" FontSize="22" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Пауза" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="118" Height="80" Margin="0,0,10,10" Click="Продолжить_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="▶" FontSize="22" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Продолжить" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="118" Height="80" Margin="0,0,10,10"
                                        Foreground="{DynamicResource CrystalDangerBrush}"
                                        Click="ЗавершитьСеанс_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⏹" FontSize="22" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Завершить" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="118" Height="80" Margin="0,0,10,10" Click="ПоказатьСообщение_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="📩" FontSize="22" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Сообщение" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="118" Height="80" Margin="0,0,10,10" Click="Перезагрузить_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔄" FontSize="22" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Перезагрузка" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="118" Height="80" Margin="0,0,10,10"
                                        Foreground="{DynamicResource CrystalDangerBrush}"
                                        Click="Выключить_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⏻" FontSize="22" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Выключить" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                            </WrapPanel>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource CrystalCard}" Margin="0,16,0,0">

                        <StackPanel>

                            <TextBlock Text="Дополнительно" Style="{StaticResource CrystalSectionTitle}"/>

