                                        <TextBlock Text="Включить" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="96" Height="72" Margin="0,0,10,10" Click="ПолучитьСостояние_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="📡" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Состояние" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="96" Height="72" Margin="0,0,10,10" Click="Заблокировать_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔒" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Блокировка" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Width="96" Height="72" Margin="0,0,10,10" Click="Разблокировать_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔓" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Разблок." FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
