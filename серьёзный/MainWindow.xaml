<Window x:Class="серьёзный.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:crystal="clr-namespace:серьёзный.CrystalUI.Behaviors"
        Title="Серьёзный"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        AllowsTransparency="False"
        Cursor="None"
        Background="{DynamicResource ЧёрныйФонОкна}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                              ResizeBorderThickness="6"
                               GlassFrameThickness="0"
                              CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>



    <Window.Resources>



        <Style x:Key="CrystalScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ПолоскаФон"
                        Background="#8A0F30"
                        CornerRadius="5"
                        Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ПолоскаФон" Property="Background" Value="#B4224A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CrystalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="{StaticResource CarbonFiberBrush}" CornerRadius="6"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CrystalScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CrystalScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                            Grid.Column="0"
                                            CanContentScroll="{TemplateBinding CanContentScroll}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                               Grid.Column="1"
                               Style="{StaticResource CrystalScrollBar}"
                               Orientation="Vertical"
                               Value="{TemplateBinding VerticalOffset}"
                               Maximum="{TemplateBinding ScrollableHeight}"
                               ViewportSize="{TemplateBinding ViewportHeight}"
                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- ФОН ОКНА: полностью чёрный -->
        <!-- ============================================ -->

        <LinearGradientBrush x:Key="ЧёрныйФонОкна" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#020202" Offset="0"/>
            <GradientStop Color="#0C0C0D" Offset="1"/>
        </LinearGradientBrush>

        <!-- ============================================ -->
        <!-- КАРБОН: диагональная плетёнка, чёрно-серая -->
        <!-- ============================================ -->

        <DrawingBrush x:Key="CarbonFiberBrush"
              TileMode="Tile"
              Viewport="0,0,14,14"
              ViewportUnits="Absolute"
              Stretch="None">

            <DrawingBrush.RelativeTransform>
                <RotateTransform Angle="45" CenterX="0.5" CenterY="0.5"/>
            </DrawingBrush.RelativeTransform>

            <DrawingBrush.Drawing>
                <DrawingGroup>

                    <GeometryDrawing Brush="#0A0A0A">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,14,14"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#161616">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,7,7"/>
                                <RectangleGeometry Rect="7,7,7,7"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#202020">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="7,0,7,7"/>
                                <RectangleGeometry Rect="0,7,7,7"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        
        


        <!-- ============================================ -->
        <!-- КРЕСТИК v2 -->
        <!-- ============================================ -->

        <Style x:Key="CloseGlyphButton" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>

                            <Ellipse x:Name="Circle"
                                     Width="40" Height="40"
                                     Fill="#1E1418"
                                     Stroke="#5C1826"
                                     StrokeThickness="1.6"/>

                            <Path Stroke="#E4A6B4"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="16" Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0,0 L 16,16 M 16,0 L 0,16"/>

                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Stroke" Value="#FF3D66"/>
                                <Setter TargetName="Circle" Property="Fill" Value="#2A1A1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ============================================ -->
        <!-- КВАДРАТ "В ОКНО" -->
        <!-- ============================================ -->

        <Style x:Key="RestoreGlyphButton" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>

                            <Ellipse x:Name="Circle"
                                     Width="40" Height="40"
                                     Fill="#1E1418"
                                     Stroke="#5C1826"
                                     StrokeThickness="1.6"/>

                            <Rectangle Width="16" Height="16"
                                       RadiusX="2" RadiusY="2"
                                       Fill="Transparent"
                                       Stroke="#E4A6B4"
                                       StrokeThickness="2"/>

                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Stroke" Value="#FF3D66"/>
                                <Setter TargetName="Circle" Property="Fill" Value="#2A1A1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- ОБЫЧНЫЕ КНОПКИ ОКНА: без MinWidth=140 -->
        <!-- (это и ломало левую колонку и WrapPanel'ы)   -->
        <!-- ============================================ -->

        <Style TargetType="Button">
            <Setter Property="Background" Value="#121013"/>
            <Setter Property="BorderBrush" Value="#242424"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E9C9D3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Bg" SnapsToDevicePixels="True">

                            <Border x:Name="БазовыйФон"
                            CornerRadius="14"
                            Background="#121013"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"/>

                            <Border x:Name="СветящийсяФон"
                            CornerRadius="14"
                            Background="#1C1620"
                            BorderBrush="#B4224A"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Opacity="0"
                            IsHitTestVisible="False"/>

                            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="СветитьсяBegin">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="СветящийсяФон"
                                                     Storyboard.TargetProperty="Opacity"
                                                        To="1" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="СветитьсяBegin"/>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="СветящийсяФон"
                                                     Storyboard.TargetProperty="Opacity"
                                                    To="0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="БазовыйФон"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.65" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="БазовыйФон"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource CrystalTextBox}"/>

        <Style x:Key="CrystalSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CrystalTextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CrystalLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CrystalTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Border x:Name="РамкаОкна"
            BorderBrush="{StaticResource CarbonFiberBrush}"
            BorderThickness="0"
            RenderTransformOrigin="1,1">

        <Border.RenderTransform>
            <ScaleTransform x:Name="МасштабОкна" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Grid>

            <Border Background="{StaticResource CarbonFiberBrush}" Opacity="0.08" IsHitTestVisible="False"/>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
               

                <!-- ============================================ -->
        <!-- ШАПКА -->
        <!-- ============================================ -->

        <Border Grid.Row="0"
                Background="{StaticResource CarbonFiberBrush}"
                BorderBrush="#2A151D"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Шапка_MouseDown">

            <Grid>

                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#80000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.5"/>
                            <GradientStop Color="#40000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#60000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.15"/>

                            <GradientStop Color="#00000000" Offset="0.85"/>
                            <GradientStop Color="#60000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                
                <Grid Margin="24,0,18,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="СЕРЬЁЗНЫЙ"
                           FontSize="22"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           VerticalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush x:Name="ЗаголовокКисть" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF2E5C" Offset="0"/>
                            <GradientStop Color="#8A0F30" Offset="0.5"/>
                            <GradientStop Color="#FF2E5C" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                        <StackPanel Margin="18,0" HorizontalAlignment="Center">
                            <TextBlock Text="ВРЕМЯ (МСК)" FontSize="10" Foreground="#7A2B3D" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ТекстЧасыАдмин" Text="00:00:00" FontSize="18" FontWeight="Bold" Foreground="#E9C9D3" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ТекстДатаАдмин" Text="" FontSize="10" Foreground="#7A2B3D" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Width="1" Height="34" Background="#3A222B" VerticalAlignment="Center"/>

                    <StackPanel Margin="18,0" HorizontalAlignment="Center">
                        <TextBlock Text="ПОДКЛЮЧЕНО ПК" FontSize="10" Foreground="#7A2B3D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ТекстПК" Text="0" FontSize="18" FontWeight="Bold" Foreground="#E9C9D3" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Width="1" Height="34" Background="#3A222B" VerticalAlignment="Center"/>

                    <StackPanel Margin="18,0" HorizontalAlignment="Center">
                        <TextBlock Text="АКТИВНЫХ СЕАНСОВ" FontSize="10" Foreground="#7A2B3D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ТекстАктивныеСеансы" Text="0" FontSize="18" FontWeight="Bold" Foreground="#E9C9D3" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Width="1" Height="34" Background="#3A222B" VerticalAlignment="Center"/>

                    <StackPanel Margin="18,0" HorizontalAlignment="Center">
                        <TextBlock Text="ЗАРАБОТАНО СЕГОДНЯ" FontSize="10" Foreground="#7A2B3D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ТекстВыручкаСегодня" Text="0 ₽" FontSize="18" FontWeight="Bold" Foreground="#FF3D66" HorizontalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource RestoreGlyphButton}" Margin="0,0,-4,0" Click="РазвернутьОкно_Click"/>
                    <Button Style="{StaticResource CloseGlyphButton}" Margin="0,0,-6,0" Click="Свернуть_Click"/>
                </StackPanel>

            </Grid>

            </Grid>

        </Border>

        <!-- ============================================ -->
        <!-- ОСНОВНАЯ ОБЛАСТЬ -->
        <!-- ============================================ -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================ -->
            <!-- ЛЕВАЯ ИКОНОЧНАЯ ПАНЕЛЬ -->
            <!-- ============================================ -->
            <Border Grid.Column="0"
                    BorderBrush="#2A151D"
                    BorderThickness="0,0,1,0">

                <Border.Background>
                    <SolidColorBrush x:Name="ФонЛевойКолонки" Color="#0A0A0A"/>
                </Border.Background>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Disabled"
                            Style="{StaticResource CrystalScrollViewer}"  
                              crystal:SmoothScrollBehavior.Enabled="True">   
                              

                    <StackPanel Margin="0,14,0,14" HorizontalAlignment="Center">

                        <Grid Width="64" Height="64" Margin="0,0,0,10">
                            <Button x:Name="КнопкаЧата"
                                    Width="64" Height="64"
                                    ToolTip="Чат с игроком"
                                    Click="Чат_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="💬" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Чат" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Border x:Name="ChatBadge"
                                    Width="18" Height="18"
                                    Background="#DC2626"
                                    CornerRadius="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-4,-4,0"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <TextBlock x:Name="ChatCount"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="White"/>
                            </Border>
                        </Grid>

                        <Button Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="Имя администратора в чате"
                                Click="ИмяАдминистратора_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="✏" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Имя" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="Аккаунты игроков"
                                Click="Аккаунты_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Аккаунты" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="История сеансов"
                                Click="История_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🕓" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="История" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="Статистика клуба"
                                Click="Статистика_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Статистика" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Grid Width="64" Height="64" Margin="0,0,0,10">
                            <Button x:Name="КнопкаМагазин"
                                    Width="64" Height="64"
                                    ToolTip="Магазин"
                                    Click="Магазин_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🛒" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Магазин" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Border x:Name="BadgeЗаказов"
                                    Width="18" Height="18"
                                    Background="#DC2626"
                                    CornerRadius="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-4,-4,0"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <TextBlock x:Name="BadgeText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="White"/>
                            </Border>
                        </Grid>

                        <Button x:Name="КнопкаИгры"
                                Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="Игры на ПК"
                                Click="КнопкаИгры_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Игры" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="Настройка списка ПК"
                                Click="НастройкаПК_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="ПК" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#2A151D" Margin="6,6,6,10"/>

                        <Button Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="Резервная копия базы"
                                Click="РезервнаяКопия_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="💾" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Бэкап" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Width="64" Height="64" Margin="0,0,0,10"
                                ToolTip="Сжечь время всем аккаунтам"
                                Foreground="{DynamicResource CrystalDangerBrush}"
                                Click="СжечьВремя_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔥" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Сжечь" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- ============================================ -->
            <!-- ЦЕНТР: ВЫБРАННЫЙ ПК -->
            <!-- ============================================ -->
            <ScrollViewer Grid.Column="1"
                            VerticalScrollBarVisibility="Auto"
                             Margin="18"
                              Style="{StaticResource CrystalScrollViewer}"
                             crystal:SmoothScrollBehavior.Enabled="True">
                          
                          
                <StackPanel>

                    <ComboBox x:Name="ВыборПК" Visibility="Collapsed" SelectionChanged="ВыборПК_SelectionChanged"/>

                    <Border Style="{StaticResource CrystalCard}">

                        <StackPanel>

                            <TextBlock x:Name="НазваниеПК"
                                       Text="Выберите ПК справа"
                                       Foreground="{DynamicResource CrystalTextBrush}"
                                       FontSize="28"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="ИнформацияПК"
                                       Foreground="{DynamicResource CrystalTextMutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>

                            <TextBlock x:Name="ТекстТаймера"
                                       Text="00:00:00"
                                       FontSize="56"
                                       FontWeight="Bold"
                                       Margin="0,14,0,0">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush x:Name="ТаймерКисть" StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF2E5C" Offset="0"/>
                                        <GradientStop Color="#8A0F30" Offset="0.5"/>
                                        <GradientStop Color="#FF2E5C" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>

                            <TextBlock x:Name="ТекстСостояния"
                                       Text="Сервер готов"
                                       Foreground="{DynamicResource CrystalTextMutedBrush}"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Border>

