<Window x:Class="серьёзный.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
        xmlns:crystal="clr-namespace:серьёзный.CrystalUI.Behaviors"
        Title="Серьёзный"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        AllowsTransparency="False"
         Topmost="True"
        Background="{DynamicResource ЧёрныйФонОкна}">





    <Window.Resources>

        <!-- ============================================ -->
        <!-- КАРБОН: диагональная плетёнка, чёрно-серая -->
        <!-- Объявлена первой намеренно: CrystalScrollBar -->
        <!-- ниже ссылается на неё через StaticResource   -->
        <!-- внутри отложенного ControlTemplate — для     -->
        <!-- StaticResource порядок в одном словаре важен, -->
        <!-- ресурс обязан идти раньше первой ссылки.      -->
        <!-- ============================================ -->

        <DrawingBrush x:Key="CarbonFiberBrush"
              TileMode="Tile"
              Viewport="0,0,14,14"
              ViewportUnits="Absolute"
              Stretch="None">

            <DrawingBrush.RelativeTransform>
                <RotateTransform Angle="45" CenterX="0.5" CenterY="0.5"/>
            </DrawingBrush.RelativeTransform>

            <DrawingBrush.Drawing>
                <DrawingGroup>

                    <GeometryDrawing Brush="#0A0A0A">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,14,14"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#161616">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,7,7"/>
                                <RectangleGeometry Rect="7,7,7,7"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#202020">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="7,0,7,7"/>
                                <RectangleGeometry Rect="0,7,7,7"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <LinearGradientBrush x:Key="ScrollThumbShimmerBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF2E5C" Offset="0"/>
            <GradientStop Color="#8A0F30" Offset="0.5"/>
            <GradientStop Color="#FF2E5C" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="ФонКолонкиБраш" Color="#0A0A0A"/>



        <Style x:Key="CrystalScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ПолоскаФон"
                         Background="{StaticResource ScrollThumbShimmerBrush}"
                                  CornerRadius="5"
                                  Margin="2,0"
                                   Opacity="0.85"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ПолоскаФон" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CrystalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="Black" CornerRadius="6"/>
                            <Border Background="{StaticResource CarbonFiberBrush}" CornerRadius="6" Opacity="0.3"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CrystalScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CrystalScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                            Grid.Column="0"
                                            CanContentScroll="{TemplateBinding CanContentScroll}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                               Grid.Column="1"
                               Style="{StaticResource CrystalScrollBar}"
                               Orientation="Vertical"
                               Value="{TemplateBinding VerticalOffset}"
                               Maximum="{TemplateBinding ScrollableHeight}"
                               ViewportSize="{TemplateBinding ViewportHeight}"
                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- ФОН ОКНА: полностью чёрный -->
        <!-- ============================================ -->

        <LinearGradientBrush x:Key="ЧёрныйФонОкна" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#020202" Offset="0"/>
            <GradientStop Color="#0C0C0D" Offset="1"/>
        </LinearGradientBrush>






        <!-- ============================================ -->
        <!-- КРЕСТИК v2 -->
        <!-- ============================================ -->

        <Style x:Key="CloseGlyphButton" TargetType="Button">
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>

                            <Ellipse x:Name="Circle"
                             Width="54" Height="54"
                             Fill="#1E1418"
                             Stroke="#5C1826"
                             StrokeThickness="1.8"/>

                            <Path Stroke="#E4A6B4"
                          StrokeThickness="2.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="22" Height="22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0,0 L 22,22 M 22,0 L 0,22"/>

                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Stroke" Value="#FF3D66"/>
                                <Setter TargetName="Circle" Property="Fill" Value="#2A1A1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>





        <!-- ============================================ -->
        <!-- КВАДРАТ "В ОКНО" -->
        <!-- ============================================ -->

        <Style x:Key="RestoreGlyphButton" TargetType="Button">
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>

                            <Ellipse x:Name="Circle"
                     Width="54" Height="54"
                     Fill="#1E1418"
                     Stroke="#5C1826"
                     StrokeThickness="1.8"/>

                            <Rectangle Width="22" Height="22"
                       RadiusX="3" RadiusY="3"
                       Fill="Transparent"
                       Stroke="#E4A6B4"
                       StrokeThickness="2.4"/>

                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Stroke" Value="#FF3D66"/>
                                <Setter TargetName="Circle" Property="Fill" Value="#2A1A1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- ОБЫЧНЫЕ КНОПКИ ОКНА: без MinWidth=140 -->
        <!-- (это и ломало левую колонку и WrapPanel'ы)   -->
        <!-- ============================================ -->

        <Style TargetType="Button">
            <Setter Property="Background" Value="#121013"/>
            <Setter Property="BorderBrush" Value="#242424"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E9C9D3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Bg" SnapsToDevicePixels="True">

                            <Border x:Name="БазовыйФон"
                            CornerRadius="14"
                            Background="#121013"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"/>

                            <Border x:Name="СветящийсяФон"
                            CornerRadius="14"
                            Background="#1C1620"
                            BorderBrush="#B4224A"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Opacity="0"
                            IsHitTestVisible="False"/>

                            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="СветитьсяBegin">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="СветящийсяФон"
                                                     Storyboard.TargetProperty="Opacity"
                                                       To="1" Duration="0:0:0">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="СветитьсяBegin"/>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="СветящийсяФон"
                                                     Storyboard.TargetProperty="Opacity"
                                                    To="0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="БазовыйФон"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.65" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="БазовыйФон"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource CrystalTextBox}"/>

        <Style x:Key="CrystalSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CrystalTextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CrystalLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CrystalTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Border x:Name="РамкаОкна"
            BorderBrush="{StaticResource CarbonFiberBrush}"
            BorderThickness="0"
            RenderTransformOrigin="1,1">

        <Border.RenderTransform>
            <ScaleTransform x:Name="МасштабОкна" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="292*"/>
                <RowDefinition Height="159*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource CarbonFiberBrush}" Opacity="0.08" IsHitTestVisible="False" Grid.RowSpan="2"/>

            <Grid Grid.RowSpan="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="96"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ============================================ -->
                <!-- ШАПКА -->
                <!-- ============================================ -->

                <Border Grid.Row="0"
                Background="{StaticResource CarbonFiberBrush}"
                BorderBrush="#2A151D"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Шапка_MouseDown">

                    <Grid>

                        <Rectangle IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#80000000" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="0.5"/>
                                    <GradientStop Color="#40000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#60000000" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="0.15"/>

                                    <GradientStop Color="#00000000" Offset="0.85"/>
                                    <GradientStop Color="#60000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Grid Margin="24,0,18,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">

                                <TextBlock Text="СЕРЬЁЗНЫЙ"
                FontSize="48"
                FontWeight="Bold"
              FontFamily="Consolas">
                                    <TextBlock.Foreground>
                                        
                                            <LinearGradientBrush x:Name="ЗаголовокКисть" StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF2E5C" Offset="0"/>
                                            <GradientStop Color="#8A0F30" Offset="0.5"/>
                                            <GradientStop Color="#FF2E5C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>

                                <TextBlock Text="КОМПЬЮТЕРНЫЙ КЛУБ"
  FontSize="22"
        FontWeight="SemiBold"                                   
                     Foreground="#7A2B3D"                       
                          Margin="2,-10,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                                <StackPanel Margin="20,0" HorizontalAlignment="Center">
                                    <TextBlock Text="ВРЕМЯ (МСК)" FontSize="12" Foreground="#7A2B3D" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ТекстЧасыАдмин" Text="00:00:00" FontSize="26" FontWeight="Bold" Foreground="#E9C9D3" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ТекстДатаАдмин" Text="" FontSize="12" Foreground="#7A2B3D" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Width="1" Height="46" Background="#3A222B" VerticalAlignment="Center"/>

                                <StackPanel Margin="20,0" HorizontalAlignment="Center">
                                    <TextBlock Text="ПОДКЛЮЧЕНО ПК" FontSize="12" Foreground="#7A2B3D" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ТекстПК" Text="0" FontSize="26" FontWeight="Bold" Foreground="#E9C9D3" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Border Width="1" Height="46" Background="#3A222B" VerticalAlignment="Center"/>

                                <StackPanel Margin="20,0" HorizontalAlignment="Center">
                                    <TextBlock Text="АКТИВНЫХ СЕАНСОВ" FontSize="12" Foreground="#7A2B3D" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ТекстАктивныеСеансы" Text="0" FontSize="26" FontWeight="Bold" Foreground="#E9C9D3" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Border Width="1" Height="46" Background="#3A222B" VerticalAlignment="Center"/>

                                <StackPanel Margin="20,0" HorizontalAlignment="Center">
                                    <TextBlock Text="ЗАРАБОТАНО СЕГОДНЯ" FontSize="12" Foreground="#7A2B3D" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ТекстВыручкаСегодня" Text="0 ₽" FontSize="26" FontWeight="Bold" Foreground="#FF3D66" HorizontalAlignment="Center"/>
                                </StackPanel>

                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource RestoreGlyphButton}" Margin="0,0,-5,0" Click="РазвернутьОкно_Click"/>
                                <Button Style="{StaticResource CloseGlyphButton}" Margin="0,0,-8,0" Click="Свернуть_Click"/>
                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>

                <!-- ============================================ -->
                <!-- ОСНОВНАЯ ОБЛАСТЬ -->
                <!-- ============================================ -->
                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- ============================================ -->
                    <!-- ЛЕВАЯ ИКОНОЧНАЯ ПАНЕЛЬ -->
                    <!-- ============================================ -->
                    <Border Grid.Column="0"
                     Background="{StaticResource ФонКолонкиБраш}"
                    BorderBrush="#2A151D"
                    BorderThickness="0,0,1,0">



                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Disabled"
                            Style="{StaticResource CrystalScrollViewer}"  
                              crystal:SmoothScrollBehavior.Enabled="True">


                            <StackPanel Margin="0,14,0,14" HorizontalAlignment="Center">

                                <Grid Width="160" Height="104">
                                    <Button x:Name="КнопкаЧата"
                Width="160" Height="104"
                ToolTip="Чат с игроком"
                Click="Чат_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="💬" FontSize="34" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Чат" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Border x:Name="ChatBadge"
                Width="24" Height="24"
                Background="#DC2626"
                CornerRadius="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,6,6,0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                                        <TextBlock x:Name="ChatCount"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="White"/>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="#2A151D" Margin="0,10,0,10"/>

                                <Button Width="160" Height="104"
            ToolTip="Имя администратора в чате"
            Click="ИмяАдминистратора_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="✏" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Имя" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Border Height="1" Background="#2A151D" Margin="0,10,0,10"/>

                                <Button Width="160" Height="104"
            ToolTip="Аккаунты игроков"
            Click="Аккаунты_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="👤" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Аккаунты" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Border Height="1" Background="#2A151D" Margin="0,10,0,10"/>

                                <Button Width="160" Height="104"
            ToolTip="История сеансов"
            Click="История_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🕓" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="История" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Border Height="1" Background="#2A151D" Margin="0,10,0,10"/>

                                <Button Width="160" Height="104"
            ToolTip="Статистика клуба"
            Click="Статистика_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="📊" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Статистика" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Border Height="1" Background="#2A151D" Margin="0,10,0,10"/>

                                <Grid Width="160" Height="104">
                                    <Button x:Name="КнопкаМагазин"
                Width="160" Height="104"
                ToolTip="Магазин"
                Click="Магазин_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🛒" FontSize="34" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Магазин" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Border x:Name="BadgeЗаказов"
                Width="24" Height="24"
                Background="#DC2626"
                CornerRadius="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,6,6,0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                                        <TextBlock x:Name="BadgeText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="White"/>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="#2A151D" Margin="0,10,0,10"/>

                                <Button x:Name="КнопкаИгры"
            Width="160" Height="104"
            ToolTip="Игры на ПК"
            Click="КнопкаИгры_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🎮" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Игры" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Border Height="1" Background="#2A151D" Margin="0,10,0,10"/>

                                <Button Width="160" Height="104"
            ToolTip="Настройка списка ПК"
            Click="НастройкаПК_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⚙" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="ПК" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Border Height="1" Background="#2A151D" Margin="0,10,0,10"/>

                                <Button Width="160" Height="104"
            ToolTip="Резервная копия базы"
            Click="РезервнаяКопия_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="💾" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Бэкап" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Border Height="1" Background="#2A151D" Margin="0,10,0,10"/>

                                <Button Width="160" Height="104"
            ToolTip="Сжечь время всем аккаунтам"
            Foreground="{DynamicResource CrystalDangerBrush}"
            Click="СжечьВремя_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔥" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Сжечь" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>

                        </ScrollViewer>

                    </Border>

                    <!-- ============================================ -->
                    <!-- ЦЕНТР: ВЫБРАННЫЙ ПК -->
                    <!-- ============================================ -->
                    <Grid Grid.Column="1" Margin="18">

                        <ScrollViewer x:Name="СкроллГлавная"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource CrystalScrollViewer}"
                              crystal:SmoothScrollBehavior.Enabled="True">


                        <StackPanel>

                                <ComboBox x:Name="ВыборПК" Visibility="Collapsed" SelectionChanged="ВыборПК_SelectionChanged"/>

                                <Border Style="{StaticResource CrystalCard}">

                                    <StackPanel>

                                    <TextBlock x:Name="НазваниеПК"
                                       Text="Выберите ПК справа"
                                       Foreground="{DynamicResource CrystalTextBrush}"
                                       FontSize="28"
                                       FontWeight="Bold"/>

                                    <TextBlock x:Name="ИнформацияПК"
                                       Foreground="{DynamicResource CrystalTextMutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>

                                    <TextBlock x:Name="ТекстТаймера"
                                       Text="00:00:00"
                                       FontSize="56"
                                       FontWeight="Bold"
                                       Margin="0,14,0,0">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush x:Name="ТаймерКисть" StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF2E5C" Offset="0"/>
                                                <GradientStop Color="#8A0F30" Offset="0.5"/>
                                                <GradientStop Color="#FF2E5C" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    <TextBlock x:Name="ТекстСостояния"
                                       Text="Сервер готов"
                                       Foreground="{DynamicResource CrystalTextMutedBrush}"
                                       Margin="0,4,0,0"/>

                                </StackPanel>

                            </Border>

                                <Border Style="{StaticResource CrystalCard}" Margin="0,16,0,0">

                                    <Grid>

                                    <Border Background="{StaticResource CarbonFiberBrush}" Opacity="0.05" IsHitTestVisible="False"/>

                                    <StackPanel>

                                        <TextBlock Text="Быстрые действия" Style="{StaticResource CrystalSectionTitle}"/>

                                        <WrapPanel Margin="0,10,0,0">

                                            <Button Width="140" Height="96" Margin="0,0,12,12" Click="НачатьСеанс_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="▶" FontSize="26" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Начать сеанс" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Width="140" Height="96" Margin="0,0,12,12" Click="Пауза_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="⏸" FontSize="26" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Пауза сеанса" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Width="140" Height="96" Margin="0,0,12,12" Click="Продолжить_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="▶" FontSize="26" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Продолжить сеанс" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Width="140" Height="96" Margin="0,0,12,12"
            Foreground="{DynamicResource CrystalDangerBrush}"
            Click="ЗавершитьСеанс_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="⏹" FontSize="26" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Завершить сеанс" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Width="140" Height="96" Margin="0,0,12,12" Click="ПоказатьСообщение_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="📩" FontSize="26" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Сообщение" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Width="140" Height="96" Margin="0,0,12,12" Click="Перезагрузить_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="🔄" FontSize="26" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Перезагрузить ПК" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                        </WrapPanel>

                                    </StackPanel>
                                </Grid>
                            </Border>

                                <Border Style="{StaticResource CrystalCard}" Margin="0,16,0,0">

                                    <StackPanel>

                                    <TextBlock Text="Дополнительно" Style="{StaticResource CrystalSectionTitle}"/>

                                    <WrapPanel Margin="0,10,0,0">

                                        <Button Width="140" Height="96" Margin="0,0,12,12" Click="ВключитьПК_Click">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="⚡" FontSize="26" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Включить ПК" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Width="140" Height="96" Margin="0,0,12,12"
            Foreground="{DynamicResource CrystalDangerBrush}"
            Click="Выключить_Click">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="⏻" FontSize="26" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Выключить ПК" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Width="140" Height="96" Margin="0,0,12,12" Click="ПолучитьСостояние_Click">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="📡" FontSize="26" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Состояние" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Width="140" Height="96" Margin="0,0,12,12" Click="Заблокировать_Click">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🔒" FontSize="26" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Блокировка" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Width="140" Height="96" Margin="0,0,12,12" Click="Разблокировать_Click">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🔓" FontSize="26" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Разблок." FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="КнопкаГолосовое"
            Width="140" Height="96" Margin="0,0,12,12"
            Click="Голосовое_Click">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock x:Name="ИконкаГолос" Text="🎤" FontSize="26" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="ТекстГолос" Text="Записать голос" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Width="140" Height="96" Margin="0,0,12,12" Click="СменитьПароль_Click">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🔑" FontSize="26" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Пароль" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Width="140" Height="96" Margin="0,0,12,12" Click="ИзменитьТекстЭкрана_Click">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="📝" FontSize="26" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Текст экрана" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Width="140" Height="96" Margin="0,0,12,12" Click="ДобавитьВремя_Click">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="➕" FontSize="26" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Время" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Width="140" Height="96" Margin="0,0,12,12" Click="УбавитьВремя_Click">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="➖" FontSize="26" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Время" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Width="140" Height="96" Margin="0,0,12,12" Click="КнопкаРазвлечения_Click">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🎰" FontSize="26" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Развлечения" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                    </WrapPanel>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>



                        <ContentControl x:Name="ПанельСодержимого"
                     Visibility="Collapsed"/>

                    </Grid>

                    <!-- ============================================ -->
                    <!-- ПРАВАЯ КОЛОНКА: СПИСОК ПК -->
                    <!-- ============================================ -->
                    <Border Grid.Column="2"
                       Background="{StaticResource ФонКолонкиБраш}"
                    BorderBrush="#2A151D"
                    BorderThickness="1,0,0,0">



                        <DockPanel Margin="14">

                            <TextBlock DockPanel.Dock="Top"
                               Text="ВСЕ КОМПЬЮТЕРЫ"
                               Foreground="{DynamicResource CrystalTextMutedBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="4,0,0,10"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                    Style="{StaticResource CrystalScrollViewer}"
                                   crystal:SmoothScrollBehavior.Enabled="True">
                                <StackPanel x:Name="СеткаПК"/>
                            </ScrollViewer>

                        </DockPanel>

                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>