<Window x:Class="серьёзный.Окна.ОкноПрофиляИгрока"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль игрока"
        Width="560"
        Height="780"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="24">

            <Border Background="#1E293B"
                    CornerRadius="20"
                    Padding="24">

                <StackPanel HorizontalAlignment="Center">

                    <Border x:Name="AvatarBorder"
                            Width="140"
                            Height="140"
                            CornerRadius="70"
                            BorderThickness="5"
                            BorderBrush="#64748B">

                        <Grid>

                            <Ellipse Fill="#374151"/>

                            <Image x:Name="Аватар"
                                   Stretch="UniformToFill"/>

                            <TextBlock x:Name="Буква"
                                       FontSize="60"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                    <TextBlock x:Name="Имя"
                               Margin="0,18,0,0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock x:Name="Статус"
                               Margin="0,8,0,0"
                               FontSize="17"
                               Foreground="#94A3B8"/>

                </StackPanel>

            </Border>

            <Border Margin="0,22,0,0"
                    Background="#1E293B"
                    CornerRadius="18"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="Профиль"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <DockPanel Margin="0,14,0,0">

                        <TextBlock Text="Баланс времени"
                                   Foreground="#CBD5E1"/>

                        <TextBlock x:Name="Баланс"
                                   DockPanel.Dock="Right"
                                   Foreground="White"
                                   FontWeight="Bold"/>

                    </DockPanel>

                    <DockPanel Margin="0,10,0,0">

                        <TextBlock Text="Рамка"
                                   Foreground="#CBD5E1"/>

                        <TextBlock x:Name="НазваниеРамки"
                                   DockPanel.Dock="Right"
                                   Foreground="White"
                                   FontWeight="Bold"/>

                    </DockPanel>

                </StackPanel>

            </Border>

            <Border Margin="0,22,0,0"
                    Background="#1E293B"
                    CornerRadius="18"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="Мои рамки"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,12"/>

                    <WrapPanel x:Name="FramesPanel"/>

                </StackPanel>

            </Border>

            <Border Margin="0,22,0,18"
                    Background="#1E293B"
                    CornerRadius="18"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="Достижения"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,12"/>

                    <StackPanel x:Name="AchievementsPanel"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</Window>