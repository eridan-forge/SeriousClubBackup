<Window x:Class="серьёзный.Core.CoreVideo.CoverEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="900" Height="650" WindowStartupLocation="CenterScreen" Background="#0F172A" Title="Редактор обложки">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <Border Margin="20" Background="#111827" CornerRadius="18">
            <Canvas x:Name="Canvas" ClipToBounds="True">
                <Image x:Name="Image"/>
                <Rectangle Width="300" Height="420" Stroke="White" StrokeThickness="2" Canvas.Left="150" Canvas.Top="70"/>
            </Canvas>
        </Border>
        <StackPanel Grid.Column="1" Margin="20">
            <TextBlock Text="300×420" FontSize="26" FontWeight="Bold" Foreground="White"/>
            <TextBlock Margin="0,16,0,0" Foreground="#94A3B8" Text="Колесо — масштаб"/>
            <TextBlock Foreground="#94A3B8" Text="ЛКМ — перетаскивание"/>
            <Button x:Name="Save" Margin="0,40,0,0" Height="42" Content="Сохранить"/>
        </StackPanel>
    </Grid>
</Window>