<Window x:Class="серьёзный.Core.CoreVideo.CoverEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900"
        Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Title="Редактор обложки">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <Grid>

            <Border Width="300"
                    Height="420"
                    CornerRadius="18"
                    BorderBrush="#38BDF8"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ClipToBounds="True">

                <Canvas x:Name="Canvas"
                        Background="#111827">

                    <Image x:Name="Image"/>

                </Canvas>

            </Border>

            <Border Background="#66000000"
                    IsHitTestVisible="False"/>

        </Grid>

        <StackPanel Grid.Column="1"
                    Margin="20">

            <TextBlock Text="300×420"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Margin="0,16,0,0"
                       Foreground="#94A3B8"
                       Text="Колесо — масштаб"/>

            <TextBlock Foreground="#94A3B8"
                       Text="ЛКМ — перетаскивание"/>

            <Button x:Name="Save"
                    Margin="0,40,0,0"
                    Height="42"
                    Content="Сохранить"/>

        </StackPanel>

    </Grid>

</Window>