<Window x:Class="серьёзный.Окна.ОкноСозданияРаздела"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360"
        Height="170"
        Title="Новый раздел"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">

    <Grid Margin="22">

        <StackPanel>

            <TextBlock Text="Название раздела"
                       Foreground="White"/>

            <TextBox x:Name="Имя"
                     Margin="0,8,0,20"/>

            <Button x:Name="Создать"
                    Height="40"
                    Content="Создать"/>

        </StackPanel>

    </Grid>

</Window>