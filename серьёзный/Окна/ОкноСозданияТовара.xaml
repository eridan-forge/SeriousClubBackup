<Window x:Class="серьёзный.Окна.ОкноСозданияТовара"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый товар"
        Width="500"
        Height="670"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">

    <Grid Margin="24">

        <Grid.RowDefinitions>

            <RowDefinition Height="240"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <Border CornerRadius="18"
                Background="#172033">

            <Grid Cursor="Hand"
MouseLeftButtonUp="Обложка_Click">
                
                <Image x:Name="Обложка"
                       Stretch="UniformToFill"/>

                <Border Background="#80000000"
                        VerticalAlignment="Bottom"
                        Padding="10">

                    <TextBlock Text="Перетащи изображение или нажми"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                </Border>

            </Grid>

        </Border>

        <StackPanel Grid.Row="1"
                    Margin="0,18,0,0">

            <TextBlock Text="Название"
                       Foreground="White"/>

            <TextBox x:Name="Название"
                     Margin="0,4,0,10"/>

            <TextBlock Text="Цена"
                       Foreground="White"/>

            <TextBox x:Name="Цена"
                     Margin="0,4,0,10"/>

            <TextBlock Text="Описание"
                       Foreground="White"/>

            <TextBox x:Name="Описание"
                     Height="80"
                     Margin="0,4,0,10"
                     AcceptsReturn="True"/>

            <TextBlock Text="Остаток (-1 = бесконечно)"
                       Foreground="White"/>

            <TextBox x:Name="Остаток"
                     Margin="0,4,0,20"
                     Text="-1"/>

            <Button x:Name="Создать"
                    Height="42"
                    Content="Создать товар"/>

        </StackPanel>

    </Grid>

</Window>