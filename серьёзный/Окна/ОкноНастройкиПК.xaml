<Window x:Class="серьёзный.Окна.ОкноНастройкиПК"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка ПК" Width="500" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CrystalMainBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="Список"
                 DisplayMemberPath="Название"
                 Background="Transparent"
                 SelectionChanged="Список_SelectionChanged"/>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">

            <UniformGrid Columns="3" Margin="0,0,0,8">
                <TextBox x:Name="ПолеId" ToolTip="Id (число)"/>
                <TextBox x:Name="ПолеНазвание" ToolTip="Название"/>
                <TextBox x:Name="ПолеMAC" ToolTip="MAC-адрес"/>
            </UniformGrid>

            <UniformGrid Columns="3">
                <Button Content="➕ Добавить" Click="Добавить_Click"/>
                <Button Content="💾 Сохранить" Click="Сохранить_Click"/>
                <Button Content="🗑 Удалить" Click="Удалить_Click"/>
            </UniformGrid>

        </StackPanel>
    </Grid>
</Window>