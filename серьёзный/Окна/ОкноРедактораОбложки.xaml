<Window x:Class="серьёзный.Окна.ОкноРедактораОбложки"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор обложки"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#111827">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Grid>

            <Border Width="300"
                    Height="420"
                    CornerRadius="18"
                    BorderBrush="#38BDF8"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ClipToBounds="True">

                <Canvas x:Name="CanvasEditor"
                        Background="#0F172A"
                        MouseWheel="Canvas_MouseWheel"
                        MouseLeftButtonDown="Canvas_MouseDown"
                        MouseLeftButtonUp="Canvas_MouseUp"
                        MouseMove="Canvas_MouseMove">

                    <Image x:Name="ImageEditor"/>

                </Canvas>

            </Border>

            <Border Background="#66000000"
                    IsHitTestVisible="False"/>

        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20">

            <Button Width="120"
                    Margin="10"
                    Content="Отмена"
                    Click="Cancel_Click"/>

            <Button Width="120"
                    Margin="10"
                    Content="Сохранить"
                    Click="Save_Click"/>

        </StackPanel>

    </Grid>

</Window>