<Window x:Class="серьёзный.Окна.ОкноЧата"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат"
        Width="430"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0F172A">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верх -->

        <Border Background="#1E293B"
                CornerRadius="12"
                Padding="12">

            <DockPanel>

                <StackPanel>

                    <TextBlock x:Name="Заголовок"
                               Text="PC-01"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="Непрочитанные"
                               Text=""
                               Foreground="#F87171"
                               FontSize="12"/>
                </StackPanel>

            </DockPanel>

        </Border>

        <!-- История -->

        <ScrollViewer Grid.Row="1"
                      Margin="0,12,0,12"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel x:Name="История"/>

        </ScrollViewer>

        <!-- Низ -->

        <Border Grid.Row="2"
                Background="#1E293B"
                CornerRadius="12"
                Padding="10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <TextBox
    x:Name="ПолеСообщения"
    Background="#334155"
    Foreground="White"
    BorderThickness="0"
    Padding="10"
    FontSize="14"
    AcceptsReturn="True"
    TextWrapping="Wrap"
    VerticalScrollBarVisibility="Auto"
    PreviewKeyDown="ПолеСообщения_PreviewKeyDown"/>

                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="➤"
                        FontSize="18"
                        Click="Отправить_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>