<Window x:Class="серьёзный.Окна.ОкноЗапуска"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#CC000000"
        ShowInTaskbar="False">

    <Grid>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Image x:Name="Cover"
                   Width="260"
                   Height="360"/>

            <TextBlock x:Name="Title"
                       Margin="0,30,0,0"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <ProgressBar
                Width="320"
                Height="6"
                Margin="0,40,0,0"
                IsIndeterminate="True"/>

        </StackPanel>

    </Grid>

</Window>