<Window x:Class="серьёзный.Окна.ОкноСеанса001"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый сеанс"
        Width="560"
        Height="700"
        MinWidth="520"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock x:Name="ПК"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Запуск нового сеанса"
                       Margin="0,5,0,0"
                       Foreground="#94A3B8"/>

        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,20"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <TextBlock Text="Имя"
                           Foreground="White"/>

                <TextBox x:Name="ПолеИмя"
                         Height="36"
                         Margin="0,6,0,8"
                         Background="#1E293B"
                         Foreground="White"
                         BorderBrush="#334155"
                         TextChanged="ПоискАккаунта"/>

                <ListBox x:Name="СписокСовпадений"
                         Visibility="Collapsed"
                         Margin="0,0,0,14"
                         MaxHeight="170"
                         SelectionChanged="ВыбранАккаунт">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Border Margin="2"
                                    Padding="10"
                                    Background="#182235">

                                <StackPanel>

                                    <TextBlock Text="{Binding ПолноеИмя}"
                                               Foreground="White"
                                               FontWeight="Bold"/>

                                    <TextBlock Foreground="#94A3B8"
                                               FontSize="11"
                                               Margin="0,4,0,0">

                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="Осталось {0} • {1} сеансов">
                                                <Binding Path="ОсталосьСтрокой"/>
                                                <Binding Path="ВсегоСеансов"/>
                                            </MultiBinding>
                                        </TextBlock.Text>

                                    </TextBlock>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

                <StackPanel x:Name="ПанельПароля">

                    <TextBlock Text="Пароль нового аккаунта"
                               Foreground="White"/>

                    <PasswordBox x:Name="ПолеПароль"
                                 Height="36"
                                 Margin="0,6,0,18"
                                 Background="#1E293B"
                                 Foreground="White"
                                 BorderBrush="#334155"
                                 PasswordChanged="ПарольИзменён"/>

                </StackPanel>

                <Border x:Name="КарточкаАккаунта"
                        Visibility="Collapsed"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock x:Name="ИмяАккаунта"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock x:Name="ТекстОстатка001"
                                   Margin="0,6,0,0"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#D5A0B0"/>

                        <TextBlock x:Name="ТекстСтатистики001"
                                   Margin="0,4,0,0"
                                   Foreground="#94A3B8"/>

                    </StackPanel>

                </Border>

                <TextBlock Text="Минут"
                           Foreground="White"/>

                <TextBox x:Name="ПолеМинут"
                         Height="36"
                         Margin="0,6,0,15"
                         Text="60"
                         Background="#1E293B"
                         Foreground="White"
                         BorderBrush="#334155"/>

                <TextBlock Text="Стоимость"
                           Foreground="White"/>

                <TextBox x:Name="ПолеСтоимость"
                         Height="36"
                         Margin="0,6,0,10"
                         Text="250"
                         Background="#1E293B"
                         Foreground="White"
                         BorderBrush="#334155"/>

            </StackPanel>

        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#182235"
                BorderBrush="#334155"
                BorderThickness="1"
                Padding="10">

            <Button Height="48"
                    Content="Начать сеанс"
                    Click="Начать"/>

        </Border>

    </Grid>

</Window>