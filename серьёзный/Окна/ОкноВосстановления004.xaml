<Window x:Class="серьёзный.Окна.ОкноВосстановления004"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление сеансов"
        Width="760"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock
                Text="Аварийное отключение"
                FontSize="30"
                FontWeight="Bold"
                Foreground="White"/>

            <TextBlock
                Margin="0,6,0,18"
                Foreground="#94A3B8"
                Text="Выберите, что делать с незавершёнными сеансами."/>

        </StackPanel>

        <ListView
            x:Name="Список"
            Grid.Row="1"
            Background="#1E293B"
            BorderThickness="0">

            <ListView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,4"
                        Padding="14"
                        Background="#162032"
                        CornerRadius="10">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding Название}"/>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="#CBD5E1"
                                    Text="{Binding Игрок}"/>

                                <TextBlock
                                    Foreground="#93C5FD"
                                    Text="{Binding ОсталосьСтрокой}"/>

                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Margin="8,0"
                                Content="▶ Возобновить"
                                Tag="{Binding}"
                                Click="Возобновить_Click"/>

                            <Button
                                Grid.Column="2"
                                Margin="8,0"
                                Content="⏹ Завершить"
                                Tag="{Binding}"
                                Click="Завершить_Click"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

        <Button
            Grid.Row="2"
            Margin="0,18,0,0"
            Height="44"
            Background="#991B1B"
            Foreground="White"
            Content="Завершить все"
            Click="ЗавершитьВсе_Click"/>

    </Grid>

</Window>