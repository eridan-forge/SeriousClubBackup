<Window x:Class="серьёзный.Окна.ОкноАккаунта007"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аккаунт"
        Width="720"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->

        <StackPanel>

            <TextBlock x:Name="Имя"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock x:Name="Последний"
                       Margin="0,6,0,0"
                       Foreground="#94A3B8"/>

        </StackPanel>

        <!-- Карточки -->

        <UniformGrid Grid.Row="1"
                     Columns="3"
                     Margin="0,20,0,20">

            <Border Margin="5"
                    CornerRadius="12"
                    Background="#1E293B">

                <StackPanel Margin="14">

                    <TextBlock Text="Осталось"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="Осталось"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>

                </StackPanel>

            </Border>

            <Border Margin="5"
                    CornerRadius="12"
                    Background="#1E293B">

                <StackPanel Margin="14">

                    <TextBlock Text="Сыграно"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="Сыграно"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>

                </StackPanel>

            </Border>

            <Border Margin="5"
                    CornerRadius="12"
                    Background="#1E293B">

                <StackPanel Margin="14">

                    <TextBlock Text="Сеансов"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="Сеансов"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>

                </StackPanel>

            </Border>

        </UniformGrid>

        <!-- История -->

        <DataGrid x:Name="Таблица"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  RowBackground="#1E293B"
                  AlternatingRowBackground="#243244"
                  Background="#0F172A"
                  BorderBrush="#334155"
                  BorderThickness="1"
                  Foreground="White"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Resources>

                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#243244"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>

                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="8"/>
                </Style>

            </DataGrid.Resources>

            <DataGrid.Columns>

                <DataGridTextColumn Header="ПК"
                                    Binding="{Binding КомпьютерId}"/>

                <DataGridTextColumn Header="Начало"
                                    Binding="{Binding Начало}"/>

                <DataGridTextColumn Header="Конец"
                                    Binding="{Binding Отключение}"/>

                <DataGridTextColumn Header="Сыграно"
                                    Binding="{Binding Сыграно}"/>

                <DataGridTextColumn Header="Возвращено"
                                    Binding="{Binding Возвращено}"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Кнопки -->

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">

            <Button x:Name="Баллы" Width="140" Height="38" Margin="0,0,10,0" Content="⭐ Баллы"/>

            <Button x:Name="Изменить"
                    Width="140"
                    Height="38"
                    Margin="0,0,10,0"
                    Content="Изменить время"/>

            <Button x:Name="ОчиститьЧат"
                    Width="140"
                    Height="38"
                    Margin="0,0,10,0"
                    Content="Очистить чат"/>

            <Button x:Name="Удалить"
                    Width="120"
                    Height="38"
                    Background="#991B1B"
                    Foreground="White"
                    Content="Удалить"/>

        </StackPanel>

    </Grid>

</Window>