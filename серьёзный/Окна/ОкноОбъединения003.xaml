<Window x:Class="серьёзный.Окна.ОкноОбъединения003"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Остаток аккаунта"
        Width="520"
        Height="451"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A">

    <Grid Margin="24">

        <StackPanel>

            <TextBlock
                Text="Остаток аккаунта"
                FontSize="26"
                FontWeight="Bold"
                Foreground="White"/>

            <TextBlock
                Margin="0,8,0,24"
                Foreground="#94A3B8"
                Text="Выберите, что сделать с оставшимся временем."/>

            <Grid Margin="0,0,0,24">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Покупаемое время -->

                <Border
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Background="#1E293B"
                    CornerRadius="12"
                    Padding="16">

                    <StackPanel>

                        <TextBlock
                            Text="Новое время"
                            Foreground="#94A3B8"
                            FontSize="13"/>

                        <TextBlock
                            x:Name="Покупка"
                            Margin="0,6,0,0"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="White"/>

                        <TextBlock
                            Margin="0,4,0,0"
                            Text="покупка"
                            Foreground="#64748B"
                            FontSize="12"/>

                    </StackPanel>

                </Border>

                <!-- Остаток аккаунта -->

                <Border
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Background="#1E293B"
                    CornerRadius="12"
                    Padding="16">

                    <StackPanel>

                        <TextBlock
                            Text="Остаток аккаунта"
                            Foreground="#94A3B8"
                            FontSize="13"/>

                        <TextBlock
                            x:Name="Остаток"
                            Margin="0,6,0,0"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="#93C5FD"/>

                        <TextBlock
                            Margin="0,4,0,0"
                            Text="доступно"
                            Foreground="#64748B"
                            FontSize="12"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- Использовать остаток -->

            <Button
                Height="48"
                Margin="0,0,0,10"
                Content="▶ Использовать остаток и начать сеанс"
                Click="Да_Click"/>

            <!-- Оставить остаток -->

            <Button
                Height="48"
                Margin="0,0,0,10"
                Content="➕ Новое время, остаток оставить"
                Click="Нет_Click"/>

            <!-- Отмена -->

            <Button
                Height="49"
                Content="✕ Отмена"
                Click="Отмена_Click"/>

        </StackPanel>

    </Grid>

</Window>