<Window x:Class="серьёзный.Окна.ОкноАктивныеЗаказы"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760"
        Height="620"
        Background="#0F172A"
        WindowStartupLocation="CenterOwner"
        Title="Активные заказы">

    <DockPanel Margin="20">

        <Border DockPanel.Dock="Top"
                Background="#162132"
                CornerRadius="14"
                Padding="18"
                Margin="0,0,0,18">

            <DockPanel>

                <TextBlock Text="Активные заказы"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                <Border DockPanel.Dock="Right"
                        Width="34"
                        Height="34"
                        CornerRadius="17"
                        Background="#DC2626">

                    <TextBlock x:Name="Badge"
                               Text="0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="Bold"/>

                </Border>

            </DockPanel>

        </Border>

        <ScrollViewer>

            <StackPanel x:Name="Orders"/>

        </ScrollViewer>

    </DockPanel>

</Window>