<Window x:Class="серьёзный.Окна.ОкноНаградКейса"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">

    <StackPanel Margin="16">
        <DataGrid x:Name="ГридНаград" Height="350" AutoGenerateColumns="False"
                  Background="#1E293B" Foreground="White">
            <DataGrid.Columns>
                <DataGridComboBoxColumn Header="Тип" SelectedItemBinding="{Binding Type}" Width="120"/>
                <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="150"/>
                <DataGridTextColumn Header="Подпись" Binding="{Binding Label}" Width="200"/>
                <DataGridTextColumn Header="Вес (шанс)" Binding="{Binding Weight}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="➕ Добавить" Width="120" Margin="0,0,10,0" Click="Добавить_Click"/>
            <Button Content="💾 Сохранить" Width="120" Margin="0,0,10,0" Click="Сохранить_Click"/>
            <Button Content="🗑 Удалить" Width="120" Click="Удалить_Click"/>
        </StackPanel>
    </StackPanel>

</Window>