<Window x:Class="серьёзный.Окна.ОкноМагазин"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Магазин"
        Width="1220"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">

    <Grid Margin="16">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель разделов -->

        <Border Grid.Column="0"
                Background="#172033"
                CornerRadius="18"
                Padding="12">

            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           Margin="6,4,6,14"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="Магазин"/>

                <ListBox x:Name="СписокРазделов"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"/>

            </DockPanel>

        </Border>

        <!-- Правая часть -->

        <Border Grid.Column="1"
                Margin="18,0,0,0"
                Background="#172033"
                CornerRadius="18"
                Padding="16">

            <DockPanel>

                <StackPanel DockPanel.Dock="Top">

                    <TextBlock x:Name="НазваниеРаздела"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="Раздел"/>

                    <TextBlock Margin="0,6,0,16"
                               Foreground="#94A3B8"
                               Text="Выберите товар."/>

                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <WrapPanel x:Name="ПанельТоваров"/>

                </ScrollViewer>

            </DockPanel>

        </Border>

    </Grid>

</Window>