<Window x:Class="серьёзный.Окна.ОкноНастройкиИгр"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Игры ПК"
        Width="1050"
        Height="650"
        Background="#111827"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Background="#1F2937"
                CornerRadius="14"
                Padding="10">

            <DockPanel>

                <Button x:Name="КнопкаДобавить"
                        DockPanel.Dock="Top"
                        Height="38"
                        Margin="0,0,0,10"
                        Content="➕ Добавить игру"
                        Click="Добавить_Click"/>

                <ScrollViewer>

                    <WrapPanel x:Name="СеткаКарточек"/>

                </ScrollViewer>

            </DockPanel>

        </Border>

        <Border Grid.Column="2"
                Background="#1F2937"
                CornerRadius="14"
                Padding="22">

            <ScrollViewer>

                <StackPanel>

                    <Image x:Name="Обложка"
                           Width="220"
                           Height="310"
                           Stretch="UniformToFill"/>

                    <Button Margin="0,12,0,20"
                            Content="🖼 Выбрать обложку"
                            Click="Обложка_Click"/>

                    <TextBlock Text="Название"
                               Foreground="White"/>

                    <TextBox x:Name="Название"/>

                    <TextBlock Margin="0,12,0,0"
                               Text="Категория"
                               Foreground="White"/>

                    <TextBox x:Name="Категория"/>

                    <TextBlock Margin="0,12,0,0"
                               Text="Описание"
                               Foreground="White"/>

                    <TextBox x:Name="Описание"
                             AcceptsReturn="True"
                             Height="70"/>

                    <TextBlock Margin="0,12,0,0"
                               Text="Путь"
                               Foreground="White"/>

                    <DockPanel>

                        <TextBox x:Name="Путь"/>

                        <Button Width="40"
                                Content="📂"
                                Click="Путь_Click"/>

                    </DockPanel>

                    <CheckBox x:Name="Скрыта"
                              Margin="0,18,0,0"
                              Content="Скрыть игру"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,24,0,0">

                        <Button Width="120"
                                Margin="0,0,10,0"
                                Content="💾 Сохранить"
                                Click="Сохранить_Click"/>

                        <Button Width="120"
                                Background="#7F1D1D"
                                Foreground="White"
                                Content="🗑 Удалить"
                                Click="Удалить_Click"/>

                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>