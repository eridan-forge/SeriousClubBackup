<Window x:Class="серьёзный.Уведомления.ОкноПроблемыИгрока"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="150"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Background="#1E293B" CornerRadius="18"
            BorderBrush="#DC2626" BorderThickness="2" Padding="18">
        <StackPanel>
            <TextBlock Text="🆘 Сигнал от игрока" FontSize="18" FontWeight="Bold" Foreground="#F87171"/>
            <TextBlock x:Name="Текст" Margin="0,8,0,0" Foreground="#CBD5E1" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,14,0,0">
                <Button x:Name="Готово" Width="120" Height="34" Margin="0,0,8,0" Content="Понятно"/>
                <Button x:Name="Закрыть" Width="90" Height="34" Content="Закрыть"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>