<Window x:Class="серьёзный.Уведомления.ShopToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340"
        Height="120"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Background="#1E293B"
            CornerRadius="18"
            Padding="18">

        <StackPanel>

            <TextBlock Text="Новый заказ"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock x:Name="Текст"
                       Margin="0,8,0,0"
                       Foreground="#CBD5E1"/>

            <WrapPanel Margin="0,14,0,0">

                <Button x:Name="Готово"
            Width="120"
            Height="34"
            Margin="0,0,8,0"
            Content="Готово"/>

                <Button x:Name="Закрыть"
            Width="90"
            Height="34"
            Content="Закрыть"/>

            </WrapPanel>

        </StackPanel>

    </Border>

</Window>