<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================= -->
    <!-- CRYSTAL BORDEAUX PALETTE      -->
    <!-- ============================= -->

    <Color x:Key="CrystalBackgroundColor">#07070A</Color>
    <Color x:Key="CrystalSurfaceColor">#100C12</Color>
    <Color x:Key="CrystalSurface2Color">#171017</Color>
    <Color x:Key="CrystalSurface3Color">#1E141C</Color>

    <Color x:Key="CrystalBorderColor">#3B2430</Color>
    <Color x:Key="CrystalBorderGlowColor">#7A173A</Color>

    <Color x:Key="CrystalAccentColor">#A91E4D</Color>
    <Color x:Key="CrystalAccent2Color">#D83468</Color>
    <Color x:Key="CrystalHighlightColor">#FF6A97</Color>

    <Color x:Key="CrystalTextColor">#F6F1F4</Color>
    <Color x:Key="CrystalTextSecondaryColor">#B9ACB4</Color>
    <Color x:Key="CrystalTextMutedColor">#756B72</Color>

    <Color x:Key="CrystalSuccessColor">#4CCB91</Color>
    <Color x:Key="CrystalWarningColor">#E4A84B</Color>
    <Color x:Key="CrystalDangerColor">#E54962</Color>
    <Color x:Key="CrystalInfoColor">#71B7FF</Color>

    <!-- Brushes -->

    <SolidColorBrush
        x:Key="CrystalBackgroundBrush"
        Color="{StaticResource CrystalBackgroundColor}" />

    <SolidColorBrush
        x:Key="CrystalSurfaceBrush"
        Color="{StaticResource CrystalSurfaceColor}" />

    <SolidColorBrush
        x:Key="CrystalSurface2Brush"
        Color="{StaticResource CrystalSurface2Color}" />

    <SolidColorBrush
        x:Key="CrystalSurface3Brush"
        Color="{StaticResource CrystalSurface3Color}" />

    <SolidColorBrush
        x:Key="CrystalBorderBrush"
        Color="{StaticResource CrystalBorderColor}" />

    <SolidColorBrush
        x:Key="CrystalAccentBrush"
        Color="{StaticResource CrystalAccentColor}" />

    <SolidColorBrush
        x:Key="CrystalAccent2Brush"
        Color="{StaticResource CrystalAccent2Color}" />

    <SolidColorBrush
        x:Key="CrystalHighlightBrush"
        Color="{StaticResource CrystalHighlightColor}" />

    <SolidColorBrush
        x:Key="CrystalTextBrush"
        Color="{StaticResource CrystalTextColor}" />

    <SolidColorBrush
        x:Key="CrystalTextSecondaryBrush"
        Color="{StaticResource CrystalTextSecondaryColor}" />

    <SolidColorBrush
        x:Key="CrystalTextMutedBrush"
        Color="{StaticResource CrystalTextMutedColor}" />

    <SolidColorBrush
        x:Key="CrystalSuccessBrush"
        Color="{StaticResource CrystalSuccessColor}" />

    <SolidColorBrush
        x:Key="CrystalWarningBrush"
        Color="{StaticResource CrystalWarningColor}" />

    <SolidColorBrush
        x:Key="CrystalDangerBrush"
        Color="{StaticResource CrystalDangerColor}" />

    <SolidColorBrush
        x:Key="CrystalInfoBrush"
        Color="{StaticResource CrystalInfoColor}" />

    <!-- Main background -->

    <LinearGradientBrush
        x:Key="CrystalMainBackgroundBrush"
        StartPoint="0,0"
        EndPoint="1,1">

        <GradientStop
            Color="#050508"
            Offset="0"/>

        <GradientStop
            Color="#0D080D"
            Offset="0.48"/>

        <GradientStop
            Color="#170B14"
            Offset="1"/>
    </LinearGradientBrush>

    <!-- Glass surface -->

    <LinearGradientBrush
        x:Key="CrystalGlassBrush"
        StartPoint="0,0"
        EndPoint="1,1">

        <GradientStop
            Color="#1C1018"
            Offset="0"/>

        <GradientStop
            Color="#120D13"
            Offset="0.52"/>

        <GradientStop
            Color="#21121D"
            Offset="1"/>
    </LinearGradientBrush>

    <!-- Accent -->

    <LinearGradientBrush
        x:Key="CrystalAccentGradientBrush"
        StartPoint="0,0"
        EndPoint="1,1">

        <GradientStop
            Color="#721536"
            Offset="0"/>

        <GradientStop
            Color="#A91E4D"
            Offset="0.55"/>

        <GradientStop
            Color="#E13E70"
            Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>