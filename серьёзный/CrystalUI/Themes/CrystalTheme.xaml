<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================= -->
    <!-- CRYSTAL WHITE PALETTE         -->
    <!-- ============================= -->

    <Color x:Key="CrystalBackgroundColor">#F4F5F8</Color>
    <Color x:Key="CrystalSurfaceColor">#FFFFFF</Color>
    <Color x:Key="CrystalSurface2Color">#F0F1F5</Color>
    <Color x:Key="CrystalSurface3Color">#E8EAF0</Color>

    <Color x:Key="CrystalBorderColor">#D7D9E1</Color>
    <Color x:Key="CrystalBorderGlowColor">#B78A9A</Color>

    <Color x:Key="CrystalAccentColor">#8D2147</Color>
    <Color x:Key="CrystalAccent2Color">#BA315E</Color>
    <Color x:Key="CrystalHighlightColor">#E66F98</Color>

    <Color x:Key="CrystalTextColor">#18161B</Color>
    <Color x:Key="CrystalTextSecondaryColor">#5D5962</Color>
    <Color x:Key="CrystalTextMutedColor">#8C8991</Color>

    <Color x:Key="CrystalSuccessColor">#238A61</Color>
    <Color x:Key="CrystalWarningColor">#B47A19</Color>
    <Color x:Key="CrystalDangerColor">#C33349</Color>
    <Color x:Key="CrystalInfoColor">#3677B8</Color>

    <!-- Brushes -->

    <SolidColorBrush
        x:Key="CrystalBackgroundBrush"
        Color="{StaticResource CrystalBackgroundColor}" />

    <SolidColorBrush
        x:Key="CrystalSurfaceBrush"
        Color="{StaticResource CrystalSurfaceColor}" />

    <SolidColorBrush
        x:Key="CrystalSurface2Brush"
        Color="{StaticResource CrystalSurface2Color}" />

    <SolidColorBrush
        x:Key="CrystalSurface3Brush"
        Color="{StaticResource CrystalSurface3Color}" />

    <SolidColorBrush
        x:Key="CrystalBorderBrush"
        Color="{StaticResource CrystalBorderColor}" />

    <SolidColorBrush
        x:Key="CrystalAccentBrush"
        Color="{StaticResource CrystalAccentColor}" />

    <SolidColorBrush
        x:Key="CrystalAccent2Brush"
        Color="{StaticResource CrystalAccent2Color}" />

    <SolidColorBrush
        x:Key="CrystalHighlightBrush"
        Color="{StaticResource CrystalHighlightColor}" />

    <SolidColorBrush
        x:Key="CrystalTextBrush"
        Color="{StaticResource CrystalTextColor}" />

    <SolidColorBrush
        x:Key="CrystalTextSecondaryBrush"
        Color="{StaticResource CrystalTextSecondaryColor}" />

    <SolidColorBrush
        x:Key="CrystalTextMutedBrush"
        Color="{StaticResource CrystalTextMutedColor}" />

    <SolidColorBrush
        x:Key="CrystalSuccessBrush"
        Color="{StaticResource CrystalSuccessColor}" />

    <SolidColorBrush
        x:Key="CrystalWarningBrush"
        Color="{StaticResource CrystalWarningColor}" />

    <SolidColorBrush
        x:Key="CrystalDangerBrush"
        Color="{StaticResource CrystalDangerColor}" />

    <SolidColorBrush
        x:Key="CrystalInfoBrush"
        Color="{StaticResource CrystalInfoColor}" />

    <!-- Main background -->

    <LinearGradientBrush
        x:Key="CrystalMainBackgroundBrush"
        StartPoint="0,0"
        EndPoint="1,1">

        <GradientStop
            Color="#FFFFFF"
            Offset="0"/>

        <GradientStop
            Color="#F2F3F7"
            Offset="0.52"/>

        <GradientStop
            Color="#E8EAF0"
            Offset="1"/>
    </LinearGradientBrush>

    <!-- Glass surface -->

    <LinearGradientBrush
        x:Key="CrystalGlassBrush"
        StartPoint="0,0"
        EndPoint="1,1">

        <GradientStop
            Color="#FFFFFF"
            Offset="0"/>

        <GradientStop
            Color="#F8F9FB"
            Offset="0.55"/>

        <GradientStop
            Color="#ECEEF3"
            Offset="1"/>
    </LinearGradientBrush>

    <!-- Accent -->

    <LinearGradientBrush
        x:Key="CrystalAccentGradientBrush"
        StartPoint="0,0"
        EndPoint="1,1">

        <GradientStop
            Color="#681632"
            Offset="0"/>

        <GradientStop
            Color="#8D2147"
            Offset="0.55"/>

        <GradientStop
            Color="#D84E78"
            Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>