<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style
        x:Key="CrystalTextBox"
        TargetType="{x:Type TextBox}">

        <Setter
            Property="Height"
            Value="44"/>

        <Setter
            Property="Padding"
            Value="14,0"/>

        <Setter
            Property="FontSize"
            Value="14"/>

        <Setter
            Property="Foreground"
            Value="{DynamicResource CrystalTextBrush}"/>

        <Setter
            Property="Background"
            Value="{DynamicResource CrystalSurface2Brush}"/>

        <Setter
            Property="BorderBrush"
            Value="{DynamicResource CrystalBorderBrush}"/>

        <Setter
            Property="BorderThickness"
            Value="1"/>

        <Setter
            Property="VerticalContentAlignment"
            Value="Center"/>

        <Setter
            Property="Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type TextBox}">

                    <Grid>

                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                            <Border.Clip>
                                <RectangleGeometry
                                    Rect="0,0,1,1"
                                    RadiusX="0.08"
                                    RadiusY="0.08"/>
                            </Border.Clip>

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <Border
                            x:Name="Glow"
                            BorderBrush="{DynamicResource CrystalGlowBrush}"
                            BorderThickness="1"
                            Opacity="0"
                            IsHitTestVisible="False">

                            <Border.Effect>
                                <DropShadowEffect
                                    Color="#FF5B8C"
                                    BlurRadius="16"
                                    ShadowDepth="0"
                                    Opacity="0.55"/>
                            </Border.Effect>

                        </Border>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger
                            Property="IsKeyboardFocused"
                            Value="True">

                            <Setter
                                TargetName="Glow"
                                Property="Opacity"
                                Value="0.75"/>

                            <Setter
                                TargetName="Border"
                                Property="BorderBrush"
                                Value="{DynamicResource CrystalAccent2Brush}"/>

                        </Trigger>

                        <Trigger
                            Property="IsMouseOver"
                            Value="True">

                            <Setter
                                TargetName="Border"
                                Property="BorderBrush"
                                Value="{DynamicResource CrystalBorderStrongBrush}"/>

                        </Trigger>

                        <Trigger
                            Property="IsEnabled"
                            Value="False">

                            <Setter
                                TargetName="Border"
                                Property="Opacity"
                                Value="0.4"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>