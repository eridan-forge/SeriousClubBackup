<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style
        x:Key="CrystalButton"
        TargetType="{x:Type Button}">

        <Setter
            Property="Height"
            Value="48"/>

        <Setter
            Property="MinWidth"
            Value="140"/>

        <Setter
            Property="Padding"
            Value="22,0"/>

        <Setter
            Property="Margin"
            Value="5"/>

        <Setter
            Property="Foreground"
            Value="{DynamicResource CrystalTextBrush}"/>

        <Setter
            Property="FontSize"
            Value="14"/>

        <Setter
            Property="FontWeight"
            Value="SemiBold"/>

        <Setter
            Property="HorizontalContentAlignment"
            Value="Center"/>

        <Setter
            Property="VerticalContentAlignment"
            Value="Center"/>

        <Setter
            Property="Background"
            Value="{DynamicResource CrystalGlassBrush}"/>

        <Setter
            Property="BorderBrush"
            Value="{DynamicResource CrystalBorderBrush}"/>

        <Setter
            Property="Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type Button}">

                    <Grid
                        x:Name="Root"
                        RenderTransformOrigin="0.5,0.5">

                        <Grid.RenderTransform>
                            <ScaleTransform
                                ScaleX="1"
                                ScaleY="1"/>
                        </Grid.RenderTransform>

                        <!-- Outer glow -->
                        <Path
                            x:Name="GlowShape"
                            Stretch="Fill"
                            Fill="Transparent"
                            Stroke="{DynamicResource CrystalGlowBrush}"
                            StrokeThickness="2"
                            Opacity="0">

                            <Path.Data>

                                <PathGeometry>

                                    <PathFigure
                                        StartPoint="18,0"
                                        IsClosed="True">

                                        <LineSegment Point="102,0"/>
                                        <LineSegment Point="120,18"/>
                                        <LineSegment Point="120,30"/>
                                        <LineSegment Point="102,48"/>
                                        <LineSegment Point="18,48"/>
                                        <LineSegment Point="0,30"/>
                                        <LineSegment Point="0,18"/>

                                    </PathFigure>

                                </PathGeometry>

                            </Path.Data>

                            <Path.Effect>
                                <DropShadowEffect
                                    Color="#FF5B8C"
                                    BlurRadius="22"
                                    ShadowDepth="0"
                                    Opacity="0.75"/>
                            </Path.Effect>

                        </Path>

                        <!-- Main crystal -->
                        <Path
                            x:Name="Surface"
                            Stretch="Fill"
                            Fill="{TemplateBinding Background}"
                            Stroke="{TemplateBinding BorderBrush}"
                            StrokeThickness="1.2">

                            <Path.Data>

                                <PathGeometry>

                                    <PathFigure
                                        StartPoint="18,0"
                                        IsClosed="True">

                                        <LineSegment Point="102,0"/>
                                        <LineSegment Point="120,18"/>
                                        <LineSegment Point="120,30"/>
                                        <LineSegment Point="102,48"/>
                                        <LineSegment Point="18,48"/>
                                        <LineSegment Point="0,30"/>
                                        <LineSegment Point="0,18"/>

                                    </PathFigure>

                                </PathGeometry>

                            </Path.Data>

                        </Path>

                        <!-- Inner light -->
                        <Path
                            x:Name="InnerGlow"
                            Stretch="Fill"
                            Fill="Transparent"
                            Stroke="{DynamicResource CrystalAccent2Brush}"
                            StrokeThickness="1"
                            Opacity="0.16"
                            IsHitTestVisible="False">

                            <Path.Data>

                                <PathGeometry>

                                    <PathFigure
                                        StartPoint="19,2"
                                        IsClosed="True">

                                        <LineSegment Point="101,2"/>
                                        <LineSegment Point="118,19"/>
                                        <LineSegment Point="118,29"/>
                                        <LineSegment Point="101,46"/>
                                        <LineSegment Point="19,46"/>
                                        <LineSegment Point="2,29"/>
                                        <LineSegment Point="2,19"/>

                                    </PathFigure>

                                </PathGeometry>

                            </Path.Data>

                        </Path>

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}"
                            RecognizesAccessKey="True"/>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger
                            Property="IsMouseOver"
                            Value="True">

                            <Setter
                                TargetName="GlowShape"
                                Property="Opacity"
                                Value="0.82"/>

                            <Setter
                                TargetName="InnerGlow"
                                Property="Opacity"
                                Value="0.55"/>

                            <Setter
                                TargetName="Surface"
                                Property="Stroke"
                                Value="{DynamicResource CrystalGlowBrush}"/>

                        </Trigger>

                        <Trigger
                            Property="IsPressed"
                            Value="True">

                            <Setter
                                TargetName="Root"
                                Property="Opacity"
                                Value="0.88"/>

                            <Setter
                                TargetName="GlowShape"
                                Property="Opacity"
                                Value="1"/>

                        </Trigger>

                        <Trigger
                            Property="IsEnabled"
                            Value="False">

                            <Setter
                                TargetName="Root"
                                Property="Opacity"
                                Value="0.38"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>